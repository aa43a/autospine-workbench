{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "autospine.character-stage-defaults/v1"
    },
    "policy_id": {
      "enum": ["supported-weighted-stage-defaults-v1", "supported-weighted-stage-defaults-v2"]
    },
    "decision_source": {
      "const": "policy_auto"
    },
    "authority": {
      "const": "none"
    },
    "production_authorized": {
      "const": false
    },
    "calibration_status": {
      "const": "unmeasured"
    },
    "visual_review_required": {
      "const": true
    },
    "reversible": {
      "const": true
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "runtime_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "layers_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "inventory_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "accepted_layer_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "human_override_layer_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema",
    "policy_id",
    "decision_source",
    "authority",
    "production_authorized",
    "calibration_status",
    "visual_review_required",
    "reversible",
    "project_id",
    "job_id",
    "artifact_sha256",
    "runtime_sha256",
    "layers_sha256",
    "inventory_sha256",
    "accepted_layer_ids",
    "human_override_layer_ids"
  ]
}
