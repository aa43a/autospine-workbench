{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "profile", "authority", "production_authorized", "source_bindings_sha256", "source_draft_sha256", "layers"],
  "properties": {
    "schema": {"const": "autospine.weighted-mesh-candidates/v1"},
    "profile": {"const": "alpha-grid-three-bone-v1"},
    "authority": {"const": "none"}, "production_authorized": {"const": false},
    "source_bindings_sha256": {"$ref": "#/$defs/sha"}, "source_draft_sha256": {"$ref": "#/$defs/sha"},
    "layers": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/layer"}}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "point": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
    "layer": {
      "type": "object", "additionalProperties": false,
      "required": ["layer_id", "status", "reason_codes", "vertices_xy", "uvs", "triangles", "weights", "qa"],
      "properties": {
        "layer_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["candidate_requires_review", "blocked", "reviewed_noop"]},
        "reason_codes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "vertices_xy": {"type": "array", "items": {"$ref": "#/$defs/point"}},
        "uvs": {"type": "array", "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": 0, "maximum": 1}}},
        "triangles": {"type": "array", "items": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "integer", "minimum": 0}}},
        "weights": {"type": "array", "items": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"$ref": "#/$defs/influence"}}},
        "qa": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/qa"}]}
      }
    },
    "influence": {
      "type": "object", "additionalProperties": false, "required": ["bone_id", "weight", "local_xy"],
      "properties": {"bone_id": {"type": "string"}, "weight": {"type": "number", "minimum": 0, "maximum": 1}, "local_xy": {"$ref": "#/$defs/point"}}
    },
    "qa": {
      "type": "object", "additionalProperties": false,
      "required": ["passed", "setup_max_error", "weight_sum_max_error", "probes"],
      "properties": {
        "passed": {"type": "boolean"}, "setup_max_error": {"type": "number", "minimum": 0},
        "weight_sum_max_error": {"type": "number", "minimum": 0},
        "probes": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["id", "inverted_triangle_count", "max_edge_stretch"],
          "properties": {"id": {"type": "string"}, "inverted_triangle_count": {"type": "integer", "minimum": 0}, "max_edge_stretch": {"type": "number", "minimum": 0}}
        }}
      }
    }
  }
}
