{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autospine.local/schemas/kimodo-npz-map-v1.schema.json",
  "title": "AutoSpine explicit Kimodo SOMA77 NPZ-to-MotionIR map v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format", "format_version", "map_id", "clip", "basis", "root",
    "bones", "contact"
  ],
  "properties": {
    "format": {"const": "autospine-kimodo-npz-map"},
    "format_version": {"type": "integer", "const": 1},
    "map_id": {"$ref": "#/$defs/id"},
    "clip": {"$ref": "#/$defs/clip"},
    "basis": {"$ref": "#/$defs/basis"},
    "root": {"$ref": "#/$defs/root"},
    "bones": {
      "type": "array",
      "minItems": 1,
      "maxItems": 17,
      "items": {"$ref": "#/$defs/bone"}
    },
    "contact": {
      "oneOf": [
        {"$ref": "#/$defs/contactDisabled"},
        {"$ref": "#/$defs/contactEnabled"}
      ]
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "signedAxis": {"enum": ["+X", "-X", "+Y", "-Y", "+Z", "-Z"]},
    "boneRole": {
      "enum": [
        "humanoid.root", "humanoid.spine.lower", "humanoid.spine.upper",
        "humanoid.neck", "humanoid.head", "humanoid.clavicle.left",
        "humanoid.arm.upper.left", "humanoid.arm.lower.left",
        "humanoid.hip.left", "humanoid.leg.upper.left",
        "humanoid.leg.lower.left", "humanoid.clavicle.right",
        "humanoid.arm.upper.right", "humanoid.arm.lower.right",
        "humanoid.hip.right", "humanoid.leg.upper.right",
        "humanoid.leg.lower.right"
      ]
    },
    "jointName": {
      "enum": [
        "Hips", "Spine1", "Spine2", "Chest", "Neck1", "Neck2", "Head",
        "HeadEnd", "Jaw", "LeftEye", "RightEye", "LeftShoulder", "LeftArm",
        "LeftForeArm", "LeftHand", "LeftHandThumb1", "LeftHandThumb2",
        "LeftHandThumb3", "LeftHandThumbEnd", "LeftHandIndex1",
        "LeftHandIndex2", "LeftHandIndex3", "LeftHandIndex4",
        "LeftHandIndexEnd", "LeftHandMiddle1", "LeftHandMiddle2",
        "LeftHandMiddle3", "LeftHandMiddle4", "LeftHandMiddleEnd",
        "LeftHandRing1", "LeftHandRing2", "LeftHandRing3", "LeftHandRing4",
        "LeftHandRingEnd", "LeftHandPinky1", "LeftHandPinky2",
        "LeftHandPinky3", "LeftHandPinky4", "LeftHandPinkyEnd",
        "RightShoulder", "RightArm", "RightForeArm", "RightHand",
        "RightHandThumb1", "RightHandThumb2", "RightHandThumb3",
        "RightHandThumbEnd", "RightHandIndex1", "RightHandIndex2",
        "RightHandIndex3", "RightHandIndex4", "RightHandIndexEnd",
        "RightHandMiddle1", "RightHandMiddle2", "RightHandMiddle3",
        "RightHandMiddle4", "RightHandMiddleEnd", "RightHandRing1",
        "RightHandRing2", "RightHandRing3", "RightHandRing4",
        "RightHandRingEnd", "RightHandPinky1", "RightHandPinky2",
        "RightHandPinky3", "RightHandPinky4", "RightHandPinkyEnd", "LeftLeg",
        "LeftShin", "LeftFoot", "LeftToeBase", "LeftToeEnd", "RightLeg",
        "RightShin", "RightFoot", "RightToeBase", "RightToeEnd"
      ]
    },
    "clip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clip_id", "loop"],
      "properties": {
        "clip_id": {"$ref": "#/$defs/id"},
        "loop": {"type": "boolean"}
      }
    },
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["screen_x", "screen_y", "depth", "rotation_convention"],
      "properties": {
        "screen_x": {"$ref": "#/$defs/signedAxis"},
        "screen_y": {"$ref": "#/$defs/signedAxis"},
        "depth": {"$ref": "#/$defs/signedAxis"},
        "rotation_convention": {"const": "validated_matrix_fk_projected_segment"}
      }
    },
    "root": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "joint_name", "position_source", "reference_length_meters",
        "translation_policy", "baseline_policy"
      ],
      "properties": {
        "joint_name": {"const": "Hips"},
        "position_source": {"const": "root_positions"},
        "reference_length_meters": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000
        },
        "translation_policy": {
          "const": "projected_frame0_delta_normalized_reference_length"
        },
        "baseline_policy": {"const": "source_frame0"}
      }
    },
    "bone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "joint_name", "aim_joint_name", "rotation_policy"],
      "properties": {
        "role": {"$ref": "#/$defs/boneRole"},
        "joint_name": {"$ref": "#/$defs/jointName"},
        "aim_joint_name": {"$ref": "#/$defs/jointName"},
        "rotation_policy": {
          "const": "projected_setup_local_delta_from_validated_fk"
        }
      }
    },
    "contactDisabled": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "mode", "interval"],
      "properties": {
        "enabled": {"const": false},
        "mode": {"const": "annotation_only"},
        "interval": {"const": "half_open"}
      }
    },
    "contactEnabled": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled", "source", "layout", "channels", "reduction_policy",
        "mode", "interval"
      ],
      "properties": {
        "enabled": {"const": true},
        "source": {"const": "foot_contacts"},
        "layout": {
          "enum": [
            "left-heel-toe-right-heel-toe-v1",
            "left-heel-toe-toe_end-right-heel-toe-toe_end-v1"
          ]
        },
        "channels": {
          "type": "array",
          "minItems": 4,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["index", "limb", "point"],
            "properties": {
              "index": {"type": "integer", "minimum": 0, "maximum": 5},
              "limb": {"enum": ["leg.left", "leg.right"]},
              "point": {"enum": ["heel", "toe", "toe_end"]}
            }
          }
        },
        "reduction_policy": {"const": "any_true_per_limb"},
        "mode": {"const": "annotation_only"},
        "interval": {"const": "half_open"}
      }
    }
  }
}
