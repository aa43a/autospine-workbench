      ],
      "properties": {
        "contact_id": {"$ref": "#/$defs/id"},
        "mode": {"enum": ["overlap", "gap"]},
        "area": {"type": "integer", "minimum": 0, "maximum": 16777216},
        "bbox_xywh": {
          "type": "array", "minItems": 4, "maxItems": 4,
