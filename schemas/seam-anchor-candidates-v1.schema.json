            {"properties": {
              "principal_axis": {"enum": ["x", "y"]},
              "sampling_profile": {
                "const": "bbox-major-axis-common-alpha-quantiles-v1"
              }
            }}
          ]
        },
        {
          "if": {"properties": {"status": {"const": "candidate"}}},
          "then": {
            "properties": {
              "reason_codes": {"maxItems": 0},
              "contact_evidence": {"$ref": "#/$defs/overlapContact"},
              "principal_axis": {"enum": ["x", "y"]},
              "sampling_profile": {
                "const": "bbox-major-axis-common-alpha-quantiles-v1"
              },
              "anchors": {"minItems": 2, "maxItems": 4}
            }
          },
          "else": {
            "properties": {
              "anchors": {"maxItems": 0}
            },
            "oneOf": [
              {"properties": {
                "contact_evidence": {"type": "null"},
                "principal_axis": {"type": "null"},
                "sampling_profile": {"type": "null"},
                "reason_codes": {
                  "minItems": 1, "maxItems": 1,
                  "items": {"enum": [
                    "SAMPLING_BUDGET_EXCEEDED",
                    "CONTACT_OVERLAP_BELOW_THRESHOLD", "CONTACT_MASK_EMPTY",
                    "CONTACT_GAP_TOO_LARGE", "CONTACT_UNOBSERVABLE"
                  ]}
                }
              }},
              {"properties": {
                "contact_evidence": {"$ref": "#/$defs/gapContact"},
                "principal_axis": {"type": "null"},
                "sampling_profile": {"type": "null"},
                "reason_codes": {"const": ["GAP_LOCATOR_UNSUPPORTED_IN_V1"]}
              }},
              {"properties": {
                "contact_evidence": {"$ref": "#/$defs/overlapContact"},
                "principal_axis": {"enum": ["x", "y"]},
                "sampling_profile": {
                  "const": "bbox-major-axis-common-alpha-quantiles-v1"
