                "reason_codes": {
                  "minItems": 1, "maxItems": 1,
                  "items": {"enum": [
                    "SAMPLING_BUDGET_EXCEEDED",
                    "INSUFFICIENT_COMMON_ALPHA_POINTS",
                    "LOCATOR_UNREPRESENTABLE"
                  ]}
                }
              }}
            ]
          }
        }
      ],
      "not": {
