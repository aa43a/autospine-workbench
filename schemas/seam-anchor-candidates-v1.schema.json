      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "overlap"}}},
          "then": {"properties": {
            "contact_id": {"pattern": "^overlap\\.[0-9]{3}$"},
            "area": {"minimum": 1},
            "overlap_ratios": {
              "items": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
            },
            "gap_distance_px": {"const": 0}
          }},
          "else": {"properties": {
            "contact_id": {"const": "gap.000"},
            "area": {"const": 0},
            "overlap_ratios": {"const": [0.0, 0.0]},
            "gap_distance_px": {"exclusiveMinimum": 0, "maximum": 8.0}
          }}
        }
      ]
    },
