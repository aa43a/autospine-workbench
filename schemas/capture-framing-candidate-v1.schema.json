{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autospine.local/schemas/capture-framing-candidate-v1.schema.json",
  "title": "AutoSpine CaptureFramingCandidate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format", "format_version", "project_id", "clip_id", "source",
    "timing", "coordinate_spaces", "envelopes", "union_envelope_canvas",
    "union_envelope_runtime", "union_extrema_witnesses", "capture_viewport",
    "proposed_world_viewport", "coverage", "compiler", "compiler_sha256",
    "semantics", "status", "release_gate"
  ],
  "properties": {
    "format": {"const": "autospine-capture-framing-candidate"},
    "format_version": {"const": 1},
    "project_id": {"$ref": "#/$defs/id"},
    "clip_id": {"$ref": "#/$defs/id"},
    "source": {"$ref": "#/$defs/source"},
    "timing": {"$ref": "#/$defs/timing"},
    "coordinate_spaces": {"$ref": "#/$defs/coordinateSpaces"},
    "envelopes": {
      "type": "object", "additionalProperties": false,
      "required": ["setup", "base", "combined"],
      "properties": {
        "setup": {"$ref": "#/$defs/envelopeRecord"},
        "base": {"$ref": "#/$defs/envelopeRecord"},
        "combined": {"$ref": "#/$defs/envelopeRecord"}
      }
    },
    "union_envelope_canvas": {"$ref": "#/$defs/envelope"},
    "union_envelope_runtime": {"$ref": "#/$defs/envelope"},
    "union_extrema_witnesses": {"$ref": "#/$defs/unionWitnesses"},
    "capture_viewport": {"$ref": "#/$defs/captureViewport"},
    "proposed_world_viewport": {"$ref": "#/$defs/worldViewport"},
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["setup", "base", "combined"],
      "properties": {
        "setup": {"const": true}, "base": {"const": true},
        "combined": {"const": true}
      }
    },
    "compiler": {"type": "object"},
    "compiler_sha256": {"$ref": "#/$defs/sha"},
    "semantics": {
      "const": {
        "scope": "sampled-capture-framing-candidate-only",
        "authority": "none",
        "setup_envelope_included": true,
        "base_envelope_included": true,
        "combined_envelope_included": true,
        "human_decision_emitted": false,
        "runtime_viewport_emitted": false,
        "runtime_equivalence_claimed": false,
        "visual_quality_claimed": false,
        "continuous_time_safety_claimed": false,
        "release_authority": false
      }
    },
    "status": {"const": "candidate_only"},
    "release_gate": {"type": "object"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "number": {"type": "number", "minimum": -1000000000000, "maximum": 1000000000000},
    "point": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "prefixItems": [{"$ref": "#/$defs/number"}, {"$ref": "#/$defs/number"}],
      "items": false
    },
    "envelope": {
      "type": "object", "additionalProperties": false,
      "required": ["min_xy", "max_xy", "size", "center_xy"],
      "properties": {
        "min_xy": {"$ref": "#/$defs/point"},
        "max_xy": {"$ref": "#/$defs/point"},
        "size": {"$ref": "#/$defs/point"},
        "center_xy": {"$ref": "#/$defs/point"}
      }
    },
    "witness": {
      "type": "object", "additionalProperties": false,
      "required": ["tick", "attachment_id", "vertex_index", "point_xy"],
      "properties": {
        "tick": {"type": "integer", "minimum": 0},
        "attachment_id": {"$ref": "#/$defs/id"},
        "vertex_index": {"type": "integer", "minimum": 0},
        "point_xy": {"$ref": "#/$defs/point"}
      }
    },
    "witnesses": {
      "type": "object", "additionalProperties": false,
      "required": ["left", "right", "top", "bottom"],
      "properties": {
        "left": {"$ref": "#/$defs/witness"},
        "right": {"$ref": "#/$defs/witness"},
        "top": {"$ref": "#/$defs/witness"},
        "bottom": {"$ref": "#/$defs/witness"}
      }
    },
    "unionWitness": {
      "type": "object", "additionalProperties": false,
      "required": [
        "envelope_kind", "tick", "attachment_id", "vertex_index", "point_xy"
      ],
      "properties": {
        "envelope_kind": {"enum": ["setup", "base", "combined"]},
        "tick": {"type": "integer", "minimum": 0},
        "attachment_id": {"$ref": "#/$defs/id"},
        "vertex_index": {"type": "integer", "minimum": 0},
        "point_xy": {"$ref": "#/$defs/point"}
      }
    },
    "unionWitnesses": {
      "type": "object", "additionalProperties": false,
      "required": ["left", "right", "top", "bottom"],
      "properties": {
        "left": {"$ref": "#/$defs/unionWitness"},
        "right": {"$ref": "#/$defs/unionWitness"},
        "top": {"$ref": "#/$defs/unionWitness"},
        "bottom": {"$ref": "#/$defs/unionWitness"}
      }
    },
    "envelopeRecord": {
      "type": "object", "additionalProperties": false,
      "required": [
        "sample_count", "attachment_sample_count", "point_count",
        "evidence_sha256", "bounds_canvas", "bounds_runtime",
        "extrema_witnesses"
      ],
      "properties": {
        "sample_count": {"type": "integer", "minimum": 1},
        "attachment_sample_count": {"type": "integer", "minimum": 1},
        "point_count": {"type": "integer", "minimum": 1},
        "evidence_sha256": {"$ref": "#/$defs/sha"},
        "bounds_canvas": {"$ref": "#/$defs/envelope"},
        "bounds_runtime": {"$ref": "#/$defs/envelope"},
        "extrema_witnesses": {"$ref": "#/$defs/witnesses"}
      }
    },
    "captureViewport": {
      "const": {
        "width": 640, "height": 640, "device_pixel_ratio": 1,
        "margin_px": {"left": 32, "right": 32, "top": 32, "bottom": 32}
      }
    },
    "worldViewport": {
      "type": "object", "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {"$ref": "#/$defs/number"}, "y": {"$ref": "#/$defs/number"},
        "width": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000000000000},
        "height": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000000000000}
      }
    },
    "coordinateSpaces": {
      "type": "object", "additionalProperties": false,
      "required": ["envelope_space", "world_viewport_space", "canvas_height", "transform_id"],
      "properties": {
        "envelope_space": {"const": "rig-canvas-top-left-y-down"},
        "world_viewport_space": {"const": "spine-world-bottom-left-y-up"},
        "canvas_height": {"type": "number", "exclusiveMinimum": 0},
        "transform_id": {"const": "rig-canvas-y-down-to-spine-world-y-up-v1"}
      }
    },
    "timing": {
      "type": "object", "additionalProperties": false,
      "required": ["ticks_per_second", "duration_ticks", "loop"],
      "properties": {
        "ticks_per_second": {"const": 1000000},
        "duration_ticks": {"type": "integer", "minimum": 1, "maximum": 600000000},
        "loop": {"type": "boolean"}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": [
        "package_id", "body_sway_probe_report_sha256",
        "dynamic_viewport_fit_sha256", "tick_schedule_sha256",
        "current_p10_1_head", "capture_framing_profile_sha256",
        "layer_manifest_sha256", "p3", "p5", "p9"
      ],
      "properties": {
        "package_id": {"$ref": "#/$defs/sha"},
        "body_sway_probe_report_sha256": {"$ref": "#/$defs/sha"},
        "dynamic_viewport_fit_sha256": {"$ref": "#/$defs/sha"},
        "tick_schedule_sha256": {"$ref": "#/$defs/sha"},
        "capture_framing_profile_sha256": {"$ref": "#/$defs/sha"},
        "layer_manifest_sha256": {"$ref": "#/$defs/sha"},
        "current_p10_1_head": {
          "type": "object", "additionalProperties": false,
          "required": ["candidate_sha256", "decision_sha256", "revision"],
          "properties": {
            "candidate_sha256": {"$ref": "#/$defs/sha"},
            "decision_sha256": {"$ref": "#/$defs/sha"},
            "revision": {"type": "integer", "minimum": 1, "maximum": 10000}
          }
        },
        "p3": {"$ref": "#/$defs/stage"},
        "p5": {"$ref": "#/$defs/stage"},
        "p9": {"$ref": "#/$defs/stage"}
      }
    },
    "stage": {
      "type": "object", "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/sha"}
    }
  }
}
