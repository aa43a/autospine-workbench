{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autospine.local/schemas/motion-instance-v3-bundle-run-v1.schema.json",
  "title": "AutoSpine immutable body-sway MotionInstance v3 bundle provenance v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format", "format_version", "project_id", "clip_id", "inputs",
    "outputs", "authority", "release_gate", "compiler"
  ],
  "properties": {
    "format": {"const": "autospine-body-sway-motion-instance-v3-bundle-run"},
    "format_version": {"type": "integer", "const": 1},
    "project_id": {"$ref": "#/$defs/token"},
    "clip_id": {"$ref": "#/$defs/token"},
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "body_sway_motion_consumer_admission_sha256", "p9",
        "motion_domain_sha256", "rotation_timeline_sha256",
        "base_channels_sha256", "rig_ir_sha256", "target_profile_sha256"
      ],
      "properties": {
        "body_sway_motion_consumer_admission_sha256": {"$ref": "#/$defs/sha256"},
        "p9": {"$ref": "#/$defs/p9"},
        "motion_domain_sha256": {"$ref": "#/$defs/sha256"},
        "rotation_timeline_sha256": {"$ref": "#/$defs/sha256"},
        "base_channels_sha256": {"$ref": "#/$defs/sha256"},
        "rig_ir_sha256": {"$ref": "#/$defs/sha256"},
        "target_profile_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "motion_instance_v3_sha256", "motion_instance_v3_profile_sha256"
      ],
      "properties": {
        "motion_instance_v3_sha256": {"$ref": "#/$defs/sha256"},
        "motion_instance_v3_profile_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "motion_instance_v3_emitted", "spine_adapter_emitted",
        "runtime_equivalence", "raster_visual_quality",
        "persistent_current_head_authority", "release_authority"
      ],
      "properties": {
        "motion_instance_v3_emitted": {"const": true},
        "spine_adapter_emitted": {"const": false},
        "runtime_equivalence": {"const": false},
        "raster_visual_quality": {"const": false},
        "persistent_current_head_authority": {"const": false},
        "release_authority": {"const": false}
      }
    },
    "release_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason_codes"],
      "properties": {
        "status": {"const": "blocked"},
        "reason_codes": {
          "const": [
            "persistent_current_head_authority_not_granted",
            "raster_visual_quality_unproven",
            "runtime_equivalence_unproven",
            "spine_adapter_not_emitted"
          ]
        }
      }
    },
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"const": "autospine-body-sway-motion-instance-v3-bundle-compiler"},
        "version": {"const": "1.0.0"}
      }
    }
  },
  "$defs": {
    "token": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "p9": {
      "type": "object",
      "additionalProperties": false,
      "required": ["motion_instance_v2_sha256", "bundle_sha256"],
      "properties": {
        "motion_instance_v2_sha256": {"$ref": "#/$defs/sha256"},
        "bundle_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
