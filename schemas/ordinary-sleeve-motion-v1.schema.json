{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object","additionalProperties":false,
  "required":["schema","profile","project_id","source_sha256","draft_sha256","skeleton_sha256","records","authority","production_authorized","runtime_status","corrective_status"],
  "properties":{
    "schema":{"const":"autospine.ordinary-sleeve-motion/v1"},
    "profile":{"const":"ordinary-forearm30-hand30-sine129-v1"},
    "project_id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "source_sha256":{"$ref":"#/$defs/sha"},"draft_sha256":{"$ref":"#/$defs/sha"},"skeleton_sha256":{"$ref":"#/$defs/sha"},
    "authority":{"const":"none"},"production_authorized":{"const":false},
    "runtime_status":{"const":"not_evaluated"},"corrective_status":{"const":"not_applied"},
    "records":{"type":"array","items":{"oneOf":[{"$ref":"#/$defs/unavailable"},{"$ref":"#/$defs/region"}]}}
  },
  "$defs":{
    "sha":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "point":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"number"}},
    "points":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/point"}},
    "unavailable":{"type":"object","additionalProperties":false,"required":["layer_id","component_id","status","reason_codes"],
      "properties":{"layer_id":{"type":"string","minLength":1},"component_id":{"type":"string","minLength":1},"status":{"const":"blocked"},
        "reason_codes":{"type":"array","minItems":1,"maxItems":1,"items":{"enum":["ordinary_sleeve_region_unavailable","ordinary_sleeve_drape_branch_required","ordinary_sleeve_roles_required"]}}}},
    "region":{"type":"object","additionalProperties":false,
      "required":["layer_id","component_id","status","reason_codes","bone_ids","setup_vertices","triangles","weights","tracks","setup_error","weight_sum_error","motion_envelope"],
      "properties":{
        "layer_id":{"type":"string","minLength":1},"component_id":{"type":"string","minLength":1},
        "status":{"enum":["blocked","candidate_requires_review"]},
        "reason_codes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["ownership_review_required","setup_reconstruction_failure","weight_sum_failure","loop_failure","motion_envelope_geometry_failure","runtime_and_alpha_contact_required"]}},
        "bone_ids":{"type":"array","minItems":3,"maxItems":3,"uniqueItems":true,"items":{"type":"string"}},
        "setup_vertices":{"$ref":"#/$defs/points"},
        "triangles":{"type":"array","minItems":1,"items":{"type":"array","minItems":3,"maxItems":3,"uniqueItems":true,"items":{"type":"integer","minimum":0}}},
        "weights":{"type":"array","minItems":1,"items":{"type":"array","minItems":3,"maxItems":3,"items":{"type":"object","additionalProperties":false,"required":["bone_id","weight","local_xy"],"properties":{"bone_id":{"type":"string"},"weight":{"type":"number","minimum":0,"maximum":1},"local_xy":{"$ref":"#/$defs/point"}}}}},
        "tracks":{"type":"array","minItems":4,"maxItems":4,"items":{"$ref":"#/$defs/track"}},
        "setup_error":{"type":"number","minimum":0},"weight_sum_error":{"type":"number","minimum":0},
        "motion_envelope":{"type":"object","additionalProperties":false,"required":["geometry_pass","alpha_contact_status","full_angle_volume_proven","combined_sampling"],"properties":{"geometry_pass":{"type":"boolean"},"alpha_contact_status":{"const":"not_evaluated"},"full_angle_volume_proven":{"const":false},"combined_sampling":{"const":"same_and_opposed_synchronized_sine"}}}
      }},
    "track":{"type":"object","additionalProperties":false,
      "required":["bone_id","drivers","amplitudes","angle_range","qa","samples","failed_ticks","correction_selected","loop_error"],
      "properties":{
        "bone_id":{"enum":["forearm","hand","combined_same","combined_opposed"]},
        "drivers":{"type":"array","minItems":2,"maxItems":2,"uniqueItems":true,"items":{"type":"string"}},
        "amplitudes":{"type":"array","minItems":2,"maxItems":2,"items":{"enum":[-30,0,30]}},
        "angle_range":{"const":[-30,30]},"correction_selected":{"const":false},
        "failed_ticks":{"type":"integer","minimum":0,"maximum":129},"loop_error":{"type":"number","minimum":0},
        "qa":{"type":"array","minItems":129,"maxItems":129,"items":{"$ref":"#/$defs/qa"}},
        "samples":{"type":"array","minItems":33,"maxItems":33,"items":{"$ref":"#/$defs/sample"}}
      }},
    "qa":{"type":"object","additionalProperties":false,"required":["inversions","min_area_ratio","max_area_ratio","max_edge_stretch","bad_triangles"],"properties":{
      "inversions":{"type":"integer","minimum":0},"min_area_ratio":{"type":"number"},"max_area_ratio":{"type":"number"},"max_edge_stretch":{"type":"number","minimum":0},"bad_triangles":{"type":"array","uniqueItems":true,"items":{"type":"integer","minimum":0}}}},
    "sample":{"type":"object","additionalProperties":false,"required":["tick","time","angles","points","bones"],"properties":{
      "tick":{"type":"integer","minimum":0,"maximum":128,"multipleOf":4},"time":{"type":"number","minimum":0,"maximum":2},"angles":{"$ref":"#/$defs/point"},"points":{"$ref":"#/$defs/points"},
      "bones":{"type":"array","minItems":3,"maxItems":3,"items":{"type":"object","additionalProperties":false,"required":["id","head_xy","tail_xy"],"properties":{"id":{"type":"string"},"head_xy":{"$ref":"#/$defs/point"},"tail_xy":{"$ref":"#/$defs/point"}}}}
    }}
  }
}
