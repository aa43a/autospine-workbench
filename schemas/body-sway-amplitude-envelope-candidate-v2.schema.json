{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autospine.local/schemas/body-sway-amplitude-envelope-candidate-v2.schema.json",
  "title": "AutoSpine BodySwayAmplitudeEnvelopeCandidate v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format", "format_version", "project_id", "clip_id", "source",
    "timing", "reviewed_selection", "parameterization", "probes",
    "analyzer", "claims", "status", "release_gate", "summary"
  ],
  "properties": {
    "format": {"const": "autospine-body-sway-amplitude-envelope-candidate"},
    "format_version": {"type": "integer", "const": 2},
    "project_id": {"$ref": "#/$defs/id"},
    "clip_id": {"$ref": "#/$defs/id"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": [
        "review_admission_v2_sha256", "review_admission_v2",
        "temporary_preview_v2_sha256", "preview_projection_v2_sha256",
        "reviewed_world_viewport", "reviewed_probe_report"
      ],
      "properties": {
        "review_admission_v2_sha256": {"$ref": "#/$defs/sha"},
        "review_admission_v2": {"$ref": "body-sway-review-admission-v2.schema.json"},
        "temporary_preview_v2_sha256": {"$ref": "#/$defs/sha"},
        "preview_projection_v2_sha256": {"$ref": "#/$defs/sha"},
        "reviewed_world_viewport": {"$ref": "#/$defs/viewport"},
        "reviewed_probe_report": {"$ref": "body-sway-probe-report-v1.schema.json"}
      }
    },
    "timing": {"$ref": "#/$defs/timing"},
    "reviewed_selection": {"$ref": "#/$defs/selection"},
    "parameterization": {"$ref": "#/$defs/parameterization"},
    "probes": {
      "type": "array", "minItems": 9, "maxItems": 9,
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/notReviewedProbe"}, {"properties": {"gain": {"properties": {"numerator": {"const": 0}}}}}]},
        {"allOf": [{"$ref": "#/$defs/notReviewedProbe"}, {"properties": {"gain": {"properties": {"numerator": {"const": 1}}}}}]},
        {"allOf": [{"$ref": "#/$defs/notReviewedProbe"}, {"properties": {"gain": {"properties": {"numerator": {"const": 2}}}}}]},
        {"allOf": [{"$ref": "#/$defs/notReviewedProbe"}, {"properties": {"gain": {"properties": {"numerator": {"const": 3}}}}}]},
        {"allOf": [{"$ref": "#/$defs/notReviewedProbe"}, {"properties": {"gain": {"properties": {"numerator": {"const": 4}}}}}]},
        {"allOf": [{"$ref": "#/$defs/notReviewedProbe"}, {"properties": {"gain": {"properties": {"numerator": {"const": 5}}}}}]},
        {"allOf": [{"$ref": "#/$defs/notReviewedProbe"}, {"properties": {"gain": {"properties": {"numerator": {"const": 6}}}}}]},
        {"allOf": [{"$ref": "#/$defs/notReviewedProbe"}, {"properties": {"gain": {"properties": {"numerator": {"const": 7}}}}}]},
        {"allOf": [{"$ref": "#/$defs/reviewedProbe"}, {"properties": {"gain": {"properties": {"numerator": {"const": 8}}}}}]}
      ],
      "items": false
    },
    "analyzer": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "canonicalization", "config"],
      "properties": {
        "id": {"const": "body-sway-amplitude-envelope-analyzer-v2"},
        "version": {"const": "2.0.0"},
        "canonicalization": {"const": "canonical-json-utf8-sort-keys-no-nonfinite"},
        "config": {
          "type": "object", "additionalProperties": false,
          "required": ["gain_grid", "time_scope", "body_sway_probe_profile", "viewport_semantics"],
          "properties": {
            "gain_grid": {"const": {"minimum_numerator": 0, "reviewed_numerator": 8, "maximum_numerator": 8, "denominator": 8}},
            "time_scope": {"const": "sampled-key-states-only"},
            "body_sway_probe_profile": {"$ref": "#/$defs/probeProfile"},
            "viewport_semantics": {"const": "reviewed-world-viewport-v2"}
          }
        }
      }
    },
    "claims": {
      "const": {
        "official_runtime_sampled_cases_approved_at_reviewed_gain": true,
        "sampled_structural_gain_probes": true,
        "continuous_preview_model_structural_safety": false,
        "safe_range": false, "visual_gain_range": false,
        "reviewed_seam_anchors": false,
        "official_runtime_continuous_equivalence": false,
        "motion_instance_v3": false, "publishable_timeline": false,
        "release_authority": false
      }
    },
    "status": {"const": "candidate_only"},
    "release_gate": {"const": {
      "status": "blocked", "reason_codes": [
        "continuous_preview_model_safety_unproven", "motion_instance_v3_not_emitted",
        "publishable_timeline_not_emitted", "reviewed_seam_anchors_missing",
        "runtime_continuous_equivalence_unproven", "visual_gain_range_unreviewed"
      ]
    }},
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["gain_probe_count", "sampled_structural_passed_count", "sampled_structural_rejected_count", "reviewed_gain_status", "sample_evaluation_count"],
      "properties": {
        "gain_probe_count": {"const": 9},
        "sampled_structural_passed_count": {"type": "integer", "minimum": 0, "maximum": 9},
        "sampled_structural_rejected_count": {"type": "integer", "minimum": 0, "maximum": 9},
        "reviewed_gain_status": {"enum": ["sampled_structural_passed", "sampled_structural_rejected"]},
        "sample_evaluation_count": {"type": "integer", "minimum": 18, "maximum": 589824}
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"summary": {"properties": {"sampled_structural_passed_count": {"const": 0}}}}}, "then": {"properties": {"probes": {"not": {"contains": {"properties": {"status": {"const": "sampled_structural_passed"}}, "required": ["status"]}}}, "summary": {"properties": {"sampled_structural_rejected_count": {"const": 9}}}}}},
    {"if": {"properties": {"summary": {"properties": {"sampled_structural_passed_count": {"const": 1}}}}}, "then": {"properties": {"probes": {"contains": {"properties": {"status": {"const": "sampled_structural_passed"}}, "required": ["status"]}, "minContains": 1, "maxContains": 1}, "summary": {"properties": {"sampled_structural_rejected_count": {"const": 8}}}}}},
    {"if": {"properties": {"summary": {"properties": {"sampled_structural_passed_count": {"const": 2}}}}}, "then": {"properties": {"probes": {"contains": {"properties": {"status": {"const": "sampled_structural_passed"}}, "required": ["status"]}, "minContains": 2, "maxContains": 2}, "summary": {"properties": {"sampled_structural_rejected_count": {"const": 7}}}}}},
    {"if": {"properties": {"summary": {"properties": {"sampled_structural_passed_count": {"const": 3}}}}}, "then": {"properties": {"probes": {"contains": {"properties": {"status": {"const": "sampled_structural_passed"}}, "required": ["status"]}, "minContains": 3, "maxContains": 3}, "summary": {"properties": {"sampled_structural_rejected_count": {"const": 6}}}}}},
    {"if": {"properties": {"summary": {"properties": {"sampled_structural_passed_count": {"const": 4}}}}}, "then": {"properties": {"probes": {"contains": {"properties": {"status": {"const": "sampled_structural_passed"}}, "required": ["status"]}, "minContains": 4, "maxContains": 4}, "summary": {"properties": {"sampled_structural_rejected_count": {"const": 5}}}}}},
    {"if": {"properties": {"summary": {"properties": {"sampled_structural_passed_count": {"const": 5}}}}}, "then": {"properties": {"probes": {"contains": {"properties": {"status": {"const": "sampled_structural_passed"}}, "required": ["status"]}, "minContains": 5, "maxContains": 5}, "summary": {"properties": {"sampled_structural_rejected_count": {"const": 4}}}}}},
    {"if": {"properties": {"summary": {"properties": {"sampled_structural_passed_count": {"const": 6}}}}}, "then": {"properties": {"probes": {"contains": {"properties": {"status": {"const": "sampled_structural_passed"}}, "required": ["status"]}, "minContains": 6, "maxContains": 6}, "summary": {"properties": {"sampled_structural_rejected_count": {"const": 3}}}}}},
    {"if": {"properties": {"summary": {"properties": {"sampled_structural_passed_count": {"const": 7}}}}}, "then": {"properties": {"probes": {"contains": {"properties": {"status": {"const": "sampled_structural_passed"}}, "required": ["status"]}, "minContains": 7, "maxContains": 7}, "summary": {"properties": {"sampled_structural_rejected_count": {"const": 2}}}}}},
    {"if": {"properties": {"summary": {"properties": {"sampled_structural_passed_count": {"const": 8}}}}}, "then": {"properties": {"probes": {"contains": {"properties": {"status": {"const": "sampled_structural_passed"}}, "required": ["status"]}, "minContains": 8, "maxContains": 8}, "summary": {"properties": {"sampled_structural_rejected_count": {"const": 1}}}}}},
    {"if": {"properties": {"summary": {"properties": {"sampled_structural_passed_count": {"const": 9}}}}}, "then": {"properties": {"probes": {"contains": {"properties": {"status": {"const": "sampled_structural_passed"}}, "required": ["status"]}, "minContains": 9, "maxContains": 9}, "summary": {"properties": {"sampled_structural_rejected_count": {"const": 0}}}}}},
    {
      "if": {"properties": {"probes": {"prefixItems": [
        {}, {}, {}, {}, {}, {}, {}, {},
        {"properties": {"status": {"const": "sampled_structural_passed"}}, "required": ["status"]}
      ]}}},
      "then": {"properties": {"summary": {"properties": {
        "reviewed_gain_status": {"const": "sampled_structural_passed"}
      }}}},
      "else": {"properties": {"summary": {"properties": {
        "reviewed_gain_status": {"const": "sampled_structural_rejected"}
      }}}}
    }
  ],
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "number": {"type": "number", "minimum": -1000000000, "maximum": 1000000000},
    "viewport": {
      "type": "object", "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {"$ref": "#/$defs/number"}, "y": {"$ref": "#/$defs/number"},
        "width": {"type": "number", "exclusiveMinimum": 0},
        "height": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "gainGrid": {"const": {"minimum_numerator": 0, "reviewed_numerator": 8, "maximum_numerator": 8, "denominator": 8}},
    "timing": {
      "type": "object", "additionalProperties": false,
      "required": ["ticks_per_second", "duration_ticks", "loop"],
      "properties": {
        "ticks_per_second": {"type": "integer", "const": 1000000},
        "duration_ticks": {"type": "integer", "minimum": 1, "maximum": 600000000},
        "loop": {"type": "boolean"}
      }
    },
    "selection": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_id", "feature_id", "action", "probe_status", "parameters"],
      "properties": {
        "candidate_id": {"type": "string", "pattern": "^body-sway-[0-9a-f]{64}$"},
        "feature_id": {"const": "body_sway"}, "action": {"const": "adjust"},
        "probe_status": {"const": "pending_probe"},
        "parameters": {
          "type": "object", "additionalProperties": false,
          "required": ["cycles", "per_bone_amplitude_deg", "per_bone_phase_fraction"],
          "properties": {
            "cycles": {"type": "integer", "minimum": 1, "maximum": 64},
            "per_bone_amplitude_deg": {"$ref": "#/$defs/amplitudes"},
            "per_bone_phase_fraction": {"$ref": "#/$defs/phases"}
          }
        }
      }
    },
    "parameterization": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "gain_grid", "cycles", "reviewed_amplitudes", "phase_fractions", "preview_time_model", "scope", "exclusions"],
      "properties": {
        "kind": {"const": "uniform_gain_along_reviewed_amplitude_vector"},
        "gain_grid": {"$ref": "#/$defs/gainGrid"},
        "cycles": {"type": "integer", "minimum": 1, "maximum": 64},
        "reviewed_amplitudes": {"$ref": "#/$defs/amplitudes"},
        "phase_fractions": {"$ref": "#/$defs/phases"},
        "preview_time_model": {"const": {"rotation_interpolation": "sampled-linear", "root_translation": "exact-motion-instance-v2", "sampling": "p10-probe-schedule", "canvas": "capture-framing-world-viewport-v2"}},
        "scope": {"const": ["reviewed_world_viewport_sampled_canvas_containment", "sampled_fk", "sampled_mesh_deformation", "shared_index_internal_continuity"]},
        "exclusions": {"const": ["continuous_time", "inter_attachment_seams", "visual_gain_range", "official_runtime_continuous_equivalence"]}
      }
    },
    "amplitudes": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/amplitude"}, {"properties": {"bone_id": {"const": "pelvis-spine"}}}]},
        {"allOf": [{"$ref": "#/$defs/amplitude"}, {"properties": {"bone_id": {"const": "spine-chest"}}}]},
        {"allOf": [{"$ref": "#/$defs/amplitude"}, {"properties": {"bone_id": {"const": "chest-neck"}}}]},
        {"allOf": [{"$ref": "#/$defs/amplitude"}, {"properties": {"bone_id": {"const": "neck-head"}}}]}
      ], "items": false
    },
    "phases": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/phase"}, {"properties": {"bone_id": {"const": "pelvis-spine"}}}]},
        {"allOf": [{"$ref": "#/$defs/phase"}, {"properties": {"bone_id": {"const": "spine-chest"}}}]},
        {"allOf": [{"$ref": "#/$defs/phase"}, {"properties": {"bone_id": {"const": "chest-neck"}}}]},
        {"allOf": [{"$ref": "#/$defs/phase"}, {"properties": {"bone_id": {"const": "neck-head"}}}]}
      ], "items": false
    },
    "amplitude": {
      "type": "object", "additionalProperties": false,
      "required": ["bone_id", "value"],
      "properties": {"bone_id": {"$ref": "#/$defs/id"}, "value": {"type": "number", "minimum": 0, "maximum": 10}}
    },
    "phase": {
      "type": "object", "additionalProperties": false,
      "required": ["bone_id", "value"],
      "properties": {"bone_id": {"$ref": "#/$defs/id"}, "value": {"type": "number", "minimum": 0, "exclusiveMaximum": 1}}
    },
    "probe": {
      "type": "object", "additionalProperties": false,
      "required": [
        "gain", "amplitudes", "sample_count", "tick_schedule_sha256",
        "sample_stream_sha256", "checks", "sampled_evidence_sha256",
        "status", "visual_review_status", "preview_relation"
      ],
      "properties": {
        "gain": {
          "type": "object", "additionalProperties": false,
          "required": ["numerator", "denominator"],
          "properties": {
            "numerator": {"type": "integer", "minimum": 0, "maximum": 8},
            "denominator": {"const": 8}
          }
        },
        "amplitudes": {"$ref": "#/$defs/amplitudes"},
        "sample_count": {"type": "integer", "minimum": 2, "maximum": 65536},
        "tick_schedule_sha256": {"$ref": "#/$defs/sha"},
        "sample_stream_sha256": {"$ref": "#/$defs/sha"},
        "checks": {"$ref": "#/$defs/checks"},
        "sampled_evidence_sha256": {"$ref": "#/$defs/sha"},
        "status": {"enum": ["sampled_structural_passed", "sampled_structural_rejected"]},
        "visual_review_status": {"enum": ["not_reviewed", "official_runtime_sampled_cases_approved"]},
        "preview_relation": {"type": "string"}
      }
    },
    "notReviewedProbe": {
      "allOf": [
        {"$ref": "#/$defs/probe"},
        {"properties": {
          "visual_review_status": {"const": "not_reviewed"},
          "preview_relation": {"const": "hypothetical-scaled-key-states"}
        }}
      ]
    },
    "reviewedProbe": {
      "allOf": [
        {"$ref": "#/$defs/probe"},
        {"properties": {
          "visual_review_status": {"const": "official_runtime_sampled_cases_approved"},
          "preview_relation": {"const": "exact-preview-v2-structural-replay-reviewed-world-viewport"}
        }}
      ]
    },
    "checks": {
      "type": "array", "minItems": 7, "maxItems": 7,
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"check_id": {"const": "loop_closure"}}}]},
        {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"check_id": {"const": "fk_finite"}}}]},
        {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"check_id": {"const": "sampled_mesh_deformation"}}}]},
        {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"check_id": {"const": "sampled_canvas_containment"}}}]},
        {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"check_id": {"const": "shared_index_internal_continuity"}}}]},
        {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"check_id": {"const": "inter_attachment_seams"}}}]},
        {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"check_id": {"const": "visual_quality"}}}]}
      ], "items": false
    },
    "check": {
      "type": "object", "additionalProperties": false,
      "required": ["check_id", "status", "reason_code", "subject_count", "sample_count", "failure_count", "evidence_sha256"],
      "properties": {
        "check_id": {"$ref": "#/$defs/id"},
        "status": {"enum": ["passed", "rejected", "unobservable", "not_applicable"]},
        "reason_code": {"$ref": "#/$defs/id"},
        "subject_count": {"type": "integer", "minimum": 0, "maximum": 4096},
        "sample_count": {"type": "integer", "minimum": 0, "maximum": 65536},
        "failure_count": {"type": "integer", "minimum": 0, "maximum": 65536},
        "evidence_sha256": {"oneOf": [{"$ref": "#/$defs/sha"}, {"type": "null"}]}
      }
    },
    "probeProfile": {"const": {
      "id": "body-sway-structural-probe", "version": "1.0.0",
      "config": {
        "fixed_sample_step_ticks": 50000, "uniform_samples_per_cycle": 32,
        "max_sample_count": 65536, "numeric_precision_decimals": 9,
        "mesh_thresholds": {"min_signed_area_ratio": 0.02, "max_signed_area_ratio": 20.0, "max_edge_stretch_ratio": 3.0}
      }
    }
    }
  }
}
