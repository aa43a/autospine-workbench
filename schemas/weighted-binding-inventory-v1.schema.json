{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "authority",
    "semantic_review",
    "regions"
  ],
  "properties": {
    "schema": {
      "const": "autospine.weighted-binding-inventory/v1"
    },
    "authority": {
      "const": "none"
    },
    "semantic_review": {
      "const": "not_inferred"
    },
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "layer_id",
          "region_id",
          "vertex_count",
          "max_influences",
          "max_weight_sum_error",
          "influences"
        ],
        "properties": {
          "layer_id": {
            "type": "string"
          },
          "region_id": {
            "type": "string"
          },
          "vertex_count": {
            "type": "integer",
            "minimum": 1
          },
          "max_influences": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64
          },
          "max_weight_sum_error": {
            "type": "number",
            "minimum": 0,
            "maximum": 1e-06
          },
          "influences": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "bone",
                "vertex_count",
                "min_weight",
                "max_weight",
                "mean_weight"
              ],
              "properties": {
                "bone": {
                  "type": "string",
                  "minLength": 1
                },
                "vertex_count": {
                  "type": "integer",
                  "minimum": 1
                },
                "min_weight": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "max_weight": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "mean_weight": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
