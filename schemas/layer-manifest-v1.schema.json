{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autospine.local/schemas/layer-manifest-v1.schema.json",
  "title": "AutoSpine layer manifest v1",
  "description": "A versioned, coordinate-stable description of normalized See-through layers before rig authoring.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "format_version",
    "project_id",
    "revision",
    "source",
    "layers",
    "qa"
  ],
  "properties": {
    "format": {
      "const": "autospine-layer-manifest"
    },
    "format_version": {
      "const": 1
    },
    "project_id": {
      "$ref": "#/$defs/id"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "psd_sha256",
        "canvas",
        "coordinate_system"
      ],
      "properties": {
        "psd_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "audit_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "relative_path": {
          "$ref": "#/$defs/relativePath"
        },
        "canvas": {
          "$ref": "#/$defs/size"
        },
        "coordinate_system": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "origin",
            "x_axis",
            "y_axis",
            "units",
            "side_naming",
            "view_orientation",
            "mirror_state"
          ],
          "properties": {
            "origin": {
              "const": "top_left"
            },
            "x_axis": {
              "const": "right"
            },
            "y_axis": {
              "const": "down"
            },
            "units": {
              "const": "pixel"
            },
            "side_naming": {
              "const": "character_side"
            },
            "view_orientation": {
              "enum": [
                "front",
                "three_quarter",
                "profile",
                "back",
                "unknown"
              ]
            },
            "mirror_state": {
              "enum": [
                "not_mirrored",
                "mirrored",
                "unknown"
              ]
            }
          }
        }
      }
    },
    "layers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/layer"
      }
    },
    "qa": {
      "$ref": "#/$defs/qa"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
    },
    "point": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "integerPoint": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer"
        },
        {
          "type": "integer"
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "size": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "integer",
          "minimum": 1
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "bbox": {
      "description": "[x, y, width, height] in source-canvas pixels.",
      "type": "array",
      "prefixItems": [
        {
          "type": "integer"
        },
        {
          "type": "integer"
        },
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "integer",
          "minimum": 0
        }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "qa": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "flags"
      ],
      "properties": {
        "status": {
          "enum": [
            "passed",
            "manual_required",
            "rejected"
          ]
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "resolvedJointGuideAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "joint_id", "xy", "review_state"],
      "properties": {
        "kind": { "const": "resolved_joint" },
        "joint_id": { "$ref": "#/$defs/id" },
        "xy": { "$ref": "#/$defs/point" },
        "review_state": {
          "enum": [
            "unreviewed",
            "candidate_accepted",
            "manual_adjusted",
            "candidate_rejected",
            "unobservable"
          ]
        }
      }
    },
    "manualProxyGuideAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "proxy_id", "xy", "label", "reason"],
      "properties": {
        "kind": { "const": "manual_proxy" },
        "proxy_id": { "$ref": "#/$defs/id" },
        "xy": { "$ref": "#/$defs/point" },
        "proxy_for_joint_id": { "$ref": "#/$defs/id" },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "splitGuideAnchor": {
      "oneOf": [
        { "$ref": "#/$defs/resolvedJointGuideAnchor" },
        { "$ref": "#/$defs/manualProxyGuideAnchor" }
      ]
    },
    "bilateralSplitConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "format_version",
        "algorithm",
        "source_layer_id",
        "source_raster_sha256",
        "source_rgba_sha256",
        "output_rgba_sha256",
        "canvas_offset_xy",
        "guide_anchors",
        "tie_break",
        "exact_partition"
      ],
      "properties": {
        "format": { "const": "autospine-bilateral-alpha-split" },
        "format_version": { "const": 1 },
        "algorithm": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version"],
          "properties": {
            "id": { "const": "nearest-limb-polyline" },
            "version": { "const": "1.1.0" }
          }
        },
        "source_layer_id": { "$ref": "#/$defs/id" },
        "source_raster_sha256": { "$ref": "#/$defs/sha256" },
        "source_rgba_sha256": { "$ref": "#/$defs/sha256" },
        "output_rgba_sha256": {
          "type": "object",
          "additionalProperties": false,
          "required": ["left", "right"],
          "properties": {
            "left": { "$ref": "#/$defs/sha256" },
            "right": { "$ref": "#/$defs/sha256" }
          }
        },
        "canvas_offset_xy": { "$ref": "#/$defs/integerPoint" },
        "guide_anchors": {
          "type": "object",
          "additionalProperties": false,
          "required": ["left", "right"],
          "properties": {
            "left": {
              "type": "array",
              "minItems": 2,
              "maxItems": 8,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/splitGuideAnchor" }
            },
            "right": {
              "type": "array",
              "minItems": 2,
              "maxItems": 8,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/splitGuideAnchor" }
            }
          }
        },
        "tie_break": { "const": "left" },
        "exact_partition": { "const": true }
      }
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer_id",
        "source",
        "raster",
        "semantic",
        "rig_hint",
        "qa"
      ],
      "properties": {
        "layer_id": {
          "$ref": "#/$defs/id"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "index",
            "visible",
            "opacity",
            "blend_mode"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "index": {
              "type": "integer",
              "minimum": 0
            },
            "group_path": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "visible": {
              "type": "boolean"
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "blend_mode": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "raster": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "artifact_path",
            "sha256",
            "canvas_size",
            "crop_bbox_xywh",
            "canvas_offset_xy",
            "channels",
            "alpha_mode",
            "color_space",
            "alpha_nonzero"
          ],
          "properties": {
            "artifact_path": {
              "$ref": "#/$defs/relativePath"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "canvas_size": {
              "$ref": "#/$defs/size"
            },
            "crop_bbox_xywh": {
              "$ref": "#/$defs/bbox"
            },
            "canvas_offset_xy": {
              "$ref": "#/$defs/point"
            },
            "channels": {
              "const": "RGBA"
            },
            "alpha_mode": {
              "const": "straight"
            },
            "color_space": {
              "const": "srgb"
            },
            "alpha_nonzero": {
              "type": "integer",
              "minimum": 0
            },
            "component_areas": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "semantic": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_tag",
            "canonical_role",
            "side",
            "mapping_method",
            "confidence"
          ],
          "properties": {
            "source_tag": {
              "type": "string"
            },
            "canonical_role": {
              "type": "string",
              "minLength": 1
            },
            "side": {
              "enum": [
                "left",
                "right",
                "center",
                "bilateral",
                "unknown"
              ]
            },
            "stratum": {
              "enum": [
                "back",
                "body",
                "front",
                "unknown"
              ]
            },
            "instance": {
              "type": "integer",
              "minimum": 0
            },
            "mapping_method": {
              "enum": [
                "exact",
                "alias",
                "components",
                "model",
                "manual",
                "unknown"
              ]
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "derivation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "parent_layer_ids"
          ],
          "properties": {
            "operation": {
              "enum": [
                "source",
                "split"
              ]
            },
            "parent_layer_ids": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "uniqueItems": true
            },
            "operation_config_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "operation_config": {
              "$ref": "#/$defs/bilateralSplitConfig"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": { "operation": { "const": "split" } },
                "required": ["operation"]
              },
              "then": {
                "required": ["operation_config_sha256", "operation_config"],
                "properties": {
                  "parent_layer_ids": {
                    "minItems": 1,
                    "maxItems": 1
                  }
                }
              },
              "else": {
                "properties": {
                  "parent_layer_ids": {
                    "maxItems": 0
                  }
                },
                "not": {
                  "anyOf": [
                    { "required": ["operation_config_sha256"] },
                    { "required": ["operation_config"] }
                  ]
                }
              }
            }
          ]
        },
        "rig_hint": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "attachment_kind",
            "setup_draw_order"
          ],
          "properties": {
            "attachment_kind": {
              "enum": [
                "region",
                "mesh",
                "sprite_set",
                "excluded",
                "unknown"
              ]
            },
            "deform_class": {
              "enum": [
                "rigid",
                "hinge",
                "soft",
                "hair",
                "cloth",
                "face",
                "unknown"
              ]
            },
            "candidate_bone": {
              "oneOf": [
                {
                  "$ref": "#/$defs/id"
                },
                {
                  "type": "null"
                }
              ]
            },
            "pivot": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "xy",
                    "method",
                    "confidence"
                  ],
                  "properties": {
                    "xy": {
                      "$ref": "#/$defs/point"
                    },
                    "method": {
                      "enum": [
                        "landmark",
                        "overlap",
                        "manual",
                        "unknown"
                      ]
                    },
                    "confidence": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "setup_draw_order": {
              "type": "integer"
            }
          }
        },
        "qa": {
          "$ref": "#/$defs/qa"
        }
      }
    }
  }
}
