{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "type":"object","additionalProperties":false,
 "required":["schema","source_arcs_sha256","analysis","authority","production_authorized","status"],
 "properties":{
  "schema":{"const":"autospine.continuous-seam-parameters/v1"},
  "source_arcs_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
  "authority":{"const":"none"},"production_authorized":{"const":false},"status":{"const":"needs_review"},
  "analysis":{"type":"object","additionalProperties":false,
   "required":["profile","relations","spacing_edges","parameter_budget_edges","world_shift_budget_px","authority","deform_solver"],
   "properties":{
    "profile":{"const":"bounded-isotonic-gap01-budget2-v1"},"authority":{"const":"none"},"deform_solver":{"const":"not_run"},
    "spacing_edges":{"const":0.1},"parameter_budget_edges":{"const":2.0},"world_shift_budget_px":{"const":2.0},
    "relations":{"type":"array","items":{"$ref":"#/$defs/relation"}}
   }}
 },
 "$defs":{
  "index":{"type":"integer","minimum":0},
  "embedding":{"type":"object","additionalProperties":false,"required":["triangle","barycentric"],
   "properties":{
    "triangle":{"type":"array","minItems":3,"maxItems":3,"items":{"$ref":"#/$defs/index"}},
    "barycentric":{"type":"array","minItems":3,"maxItems":3,"items":{"type":"number"}}
   }},
  "sample":{"type":"object","additionalProperties":false,"required":["parameter","pixel_xy","embedding"],
   "properties":{
    "parameter":{"type":"number","minimum":0},
    "pixel_xy":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"number"}},
    "embedding":{"$ref":"#/$defs/embedding"}
   }},
  "group":{"type":"object","additionalProperties":false,"required":["driver_arc","follower_arc","pairs","status","reason_code"],
   "properties":{
    "driver_arc":{"$ref":"#/$defs/index"},"follower_arc":{"$ref":"#/$defs/index"},
    "pairs":{"type":"array","items":{"$ref":"#/$defs/index"}},
    "status":{"enum":["blocked","candidate_requires_review"]},
    "reason_code":{"enum":["insufficient_arc_pairs","no_bounded_embedded_monotone_solution","continuous_parameter_candidate"]},
    "reference_parameters":{"type":"array","items":{"type":"number"}},
    "direction":{"enum":[-1,1]},"cost":{"type":"number","minimum":0},
    "samples":{"type":"array","items":{"$ref":"#/$defs/sample"}},
    "max_world_shift_px":{"type":"number","minimum":0,"maximum":2},
    "orientation_margin":{"type":["number","null"],"minimum":0}
   },
   "if":{"properties":{"status":{"const":"candidate_requires_review"}}},
   "then":{"required":["reference_parameters","direction","cost","samples","max_world_shift_px","orientation_margin"]}
  },
  "relation":{"type":"object","additionalProperties":false,"required":["driver","follower","source_pair_count","groups","blocked_pairs"],
   "properties":{
    "driver":{"type":"string"},"follower":{"type":"string"},"source_pair_count":{"$ref":"#/$defs/index"},
    "groups":{"type":"array","items":{"$ref":"#/$defs/group"}},
    "blocked_pairs":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["pair","reason_code"],
     "properties":{"pair":{"$ref":"#/$defs/index"},"reason_code":{"const":"arc_missing_or_ambiguous"}}}}
   }}
 }
}
