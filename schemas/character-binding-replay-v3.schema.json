{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "autospine.character-binding-replay/v3"
    },
    "profile": {
      "const": "exact-post-component-exclusion-binding-v1"
    },
    "decision_source": {
      "const": "verified_scope_replay"
    },
    "new_human_confirmation": {
      "const": false
    },
    "whole_character_visual_replayed": {
      "const": false
    },
    "authority": {
      "const": "none"
    },
    "production_authorized": {
      "const": false
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "source_job_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "runtime_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "layers_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_bundle_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_review_sha256": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      ]
    },
    "accepted_layer_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_replay_sha256": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      ]
    }
  },
  "required": [
    "schema",
    "profile",
    "decision_source",
    "new_human_confirmation",
    "whole_character_visual_replayed",
    "authority",
    "production_authorized",
    "project_id",
    "job_id",
    "source_job_id",
    "artifact_sha256",
    "runtime_sha256",
    "layers_sha256",
    "source_bundle_sha256",
    "source_review_sha256",
    "accepted_layer_ids",
    "source_replay_sha256"
  ],
  "anyOf": [
    {
      "properties": {
        "source_review_sha256": {
          "type": "string"
        }
      }
    },
    {
      "properties": {
        "source_replay_sha256": {
          "type": "string"
        }
      }
    }
  ]
}
