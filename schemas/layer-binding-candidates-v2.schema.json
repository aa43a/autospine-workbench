{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "autospine.layer-binding-candidates/v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profile",
    "authority",
    "production_authorized",
    "candidate_sha256",
    "source_skeleton_sha256",
    "canvas",
    "status",
    "bindings"
  ],
  "properties": {
    "schema": {
      "const": "autospine.layer-binding-candidates/v2"
    },
    "profile": {
      "const": "rigid-or-limb-chain-v2"
    },
    "authority": {
      "const": "none"
    },
    "production_authorized": {
      "const": false
    },
    "candidate_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_skeleton_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "canvas": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 4096
      }
    },
    "status": {
      "enum": [
        "needs_review",
        "blocked"
      ]
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "layer_id",
          "image_sha256",
          "bbox",
          "options",
          "suggested_option_id",
          "status",
          "reason_codes"
        ],
        "properties": {
          "layer_id": {
            "type": "string"
          },
          "image_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bbox": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "integer"
            }
          },
          "options": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "mode",
                "bone_ids",
                "setup_local"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "mode": {
                  "enum": [
                    "rigid",
                    "mesh_chain"
                  ]
                },
                "bone_ids": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 6,
                  "uniqueItems": true,
                  "items": {
                    "type": "string"
                  }
                },
                "setup_local": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "x",
                        "y",
                        "rotation_degrees"
                      ],
                      "properties": {
                        "x": {
                          "type": "number"
                        },
                        "y": {
                          "type": "number"
                        },
                        "rotation_degrees": {
                          "type": "number"
                        }
                      }
                    }
                  ]
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "mode": {
                        "const": "rigid"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "bone_ids": {
                        "minItems": 1,
                        "maxItems": 1
                      },
                      "setup_local": {
                        "type": "object"
                      }
                    }
                  },
                  "else": {
                    "properties": {
                      "bone_ids": {
                        "oneOf": [
                          {"minItems": 3, "maxItems": 3},
                          {"minItems": 6, "maxItems": 6}
                        ]
                      },
                      "setup_local": {
                        "type": "null"
                      }
                    }
                  }
                }
              ]
            }
          },
          "suggested_option_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "needs_review",
              "blocked"
            ]
          },
          "reason_codes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
