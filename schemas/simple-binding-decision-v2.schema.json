{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "autospine.simple-binding-decision/v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "authority",
    "production_authorized",
    "decision_source",
    "project_id",
    "proposal",
    "before_registration_sha256",
    "after_registration_sha256",
    "before_draft_sha256",
    "after_draft_sha256",
    "changed_layer_ids"
  ],
  "properties": {
    "schema": {
      "const": "autospine.simple-binding-decision/v2"
    },
    "authority": {
      "const": "none"
    },
    "production_authorized": {
      "const": false
    },
    "decision_source": {
      "const": "policy_auto"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "authority",
        "production_authorized",
        "policy_id",
        "limits",
        "calibration_status",
        "source_addresses",
        "rows"
      ],
      "properties": {
        "schema": {
          "const": "autospine.simple-binding-policy/v2"
        },
        "authority": {
          "const": "none"
        },
        "production_authorized": {
          "const": false
        },
        "policy_id": {
          "const": "head-and-foot-binding-v2"
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "foot",
            "head"
          ],
          "properties": {
            "foot": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "alpha",
                "max_height_calf_ratio",
                "max_width_calf_ratio",
                "max_above_ankle_calf_ratio",
                "min_other_ankle_margin_calf_ratio"
              ],
              "properties": {
                "alpha": {
                  "const": 8
                },
                "max_height_calf_ratio": {
                  "const": 0.65
                },
                "max_width_calf_ratio": {
                  "const": 0.6
                },
                "max_above_ankle_calf_ratio": {
                  "const": 0.2
                },
                "min_other_ankle_margin_calf_ratio": {
                  "const": 0.5
                }
              }
            },
            "head": {
              "const": {
                "alpha": 8,
                "min_face_overlap": 0.98,
                "max_feature_face_area_ratio": 0.35
              }
            }
          }
        },
        "calibration_status": {
          "const": "unmeasured"
        },
        "source_addresses": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "layer_id",
              "status",
              "option_id",
              "reason_codes",
              "evidence",
              "checks"
            ],
            "properties": {
              "layer_id": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "eligible",
                  "needs_review",
                  "preserved"
                ]
              },
              "option_id": {
                "enum": [
                  null,
                  "rigid:foot_l",
                  "rigid:foot_r",
                  "rigid:head"
                ]
              },
              "reason_codes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "evidence": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "number",
                    "boolean",
                    "string"
                  ]
                }
              },
              "checks": {
                "type": "object",
                "additionalProperties": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "before_registration_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "after_registration_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "before_draft_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "after_draft_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "changed_layer_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    }
  }
}
