{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autospine-workbench.local/schemas/animated-pipeline-run-v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "project_id", "source_addresses", "clip", "engine", "engine_sha256", "target_version", "run_id", "authority", "status", "preview_available", "summary", "review_items", "steps"],
  "properties": {
    "schema": {"const": "autospine.animated-pipeline-run/v1"},
    "project_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "source_addresses": {"$ref": "workbench-animated-definitions-v1.schema.json#/$defs/addresses"},
    "clip": {"$ref": "workbench-animated-definitions-v1.schema.json#/$defs/clip"},
    "engine": {"const": "workbench-weighted-animation-v1"},
    "engine_sha256": {"$ref": "workbench-animated-definitions-v1.schema.json#/$defs/sha"},
    "target_version": {"const": "4.3.26"}, "run_id": {"type": "string", "pattern": "^run-[0-9a-f]{64}$"},
    "authority": {"const": "none"}, "status": {"$ref": "workbench-animated-definitions-v1.schema.json#/$defs/status"},
    "preview_available": {"type": "boolean"},
    "summary": {"oneOf": [{"type": "object", "maxProperties": 0}, {"$ref": "workbench-animated-definitions-v1.schema.json#/$defs/summary"}]},
    "review_items": {"type": "array", "items": {"$ref": "workbench-animated-definitions-v1.schema.json#/$defs/review"}},
    "steps": {
      "type": "array", "minItems": 4, "maxItems": 4, "items": false,
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/step"}, {"properties": {"id": {"const": "resolve-project"}}}]},
        {"allOf": [{"$ref": "#/$defs/step"}, {"properties": {"id": {"const": "build-weighted-mesh"}}}]},
        {"allOf": [{"$ref": "#/$defs/step"}, {"properties": {"id": {"const": "compile-animated-preview"}}}]},
        {"allOf": [{"$ref": "#/$defs/step"}, {"properties": {"id": {"const": "review-animation"}}}]}
      ]
    }
  },
  "allOf": [{
    "if": {"properties": {"preview_available": {"const": true}}},
    "then": {"properties": {
      "status": {"const": "needs_review"},
      "summary": {"$ref": "workbench-animated-definitions-v1.schema.json#/$defs/summary"},
      "steps": {"prefixItems": [
        {"properties": {"status": {"const": "succeeded"}}},
        {"properties": {"status": {"const": "succeeded"}}},
        {"properties": {"status": {"const": "succeeded"}}},
        {"properties": {"status": {"const": "needs_review"}}}
      ]}
    }}
  }],
  "$defs": {"step": {
    "type": "object", "additionalProperties": false, "required": ["id", "status", "outputs", "reason_code"],
    "properties": {
      "id": {"type": "string"}, "status": {"$ref": "workbench-animated-definitions-v1.schema.json#/$defs/status"},
      "outputs": {"type": "object", "additionalProperties": {"$ref": "workbench-animated-definitions-v1.schema.json#/$defs/sha"}},
      "reason_code": {"type": ["string", "null"]}
    }
  }}
}
