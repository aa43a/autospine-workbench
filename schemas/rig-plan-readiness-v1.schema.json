{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "profile", "input_identity_sha256", "source_plan_sha256", "authority", "production_authorized", "layers"],
  "properties": {
    "schema": {"const": "autospine.rig-plan-readiness/v1"},
    "profile": {"const": "garment-partition-readiness-v1"},
    "input_identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authority": {"const": "none"}, "production_authorized": {"const": false},
    "layers": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["layer_id", "strategy", "status", "reason_codes", "next_action", "mesh_option_ids"],
      "properties": {
        "layer_id": {"type": "string", "minLength": 1},
        "strategy": {"enum": ["weighted_mesh", "partition_mesh", "semantic_review"]},
        "status": {"enum": ["needs_review", "blocked"]},
        "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["no_opaque_alpha_support", "garment_semantics_review_required", "reviewed_partition_artifact_required", "mesh_coverage_and_deformation_review_required", "disconnected_alpha_ownership_review_required", "mesh_chain_ambiguous", "supported_mesh_chain_evidence_missing"]}},
        "next_action": {"enum": ["review_semantics_and_split_need", "review_partition_ownership", "review_binding_and_geometry"]},
        "mesh_option_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }}
  }
}
