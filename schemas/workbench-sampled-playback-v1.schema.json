{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autospine-workbench.local/schemas/workbench-sampled-playback-v1.schema.json",
  "description": "Large sampled CPU data; AnimatedStore independently enforces 64 MiB/file and 256 MiB/bundle, not the 128 KiB run journal limit.",
  "type": "object", "additionalProperties": false,
  "required": ["fps", "duration", "canvas", "layers", "frames", "renderer", "authority"],
  "properties": {
    "fps": {"const": 30}, "duration": {"const": 2}, "renderer": {"const": "sampled_cpu_diagnostic"}, "authority": {"const": "none"},
    "canvas": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 1, "maximum": 4096}},
    "layers": {"type": "array", "minItems": 1, "maxItems": 1024, "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "image", "uvs", "triangles"],
      "properties": {
        "id": {"type": "string"}, "image": {"type": "string", "pattern": "^images/[A-Za-z0-9_.-]+\\.png$"},
        "uvs": {"type": "array", "minItems": 3, "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": 0, "maximum": 1}}},
        "triangles": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "integer", "minimum": 0}}}
      }
    }},
    "frames": {"type": "array", "minItems": 61, "maxItems": 61, "items": {
      "type": "object", "additionalProperties": false, "required": ["time", "vertices"],
      "properties": {
        "time": {"type": "number", "minimum": 0, "maximum": 2},
        "vertices": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "array", "minItems": 3, "items": {"$ref": "workbench-animated-definitions-v1.schema.json#/$defs/point"}}}
      }
    }}
  }
}
