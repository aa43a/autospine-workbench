{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autospine-workbench.local/schemas/animated-input-registration-v1.schema.json",
  "title": "Animated project source registration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "authority", "production_authorized", "project_id", "manifest", "source_draft_sha256", "checkpoint", "revision", "previous_sha256"],
  "properties": {
    "schema": {"const": "autospine.animated-input-registration/v1"},
    "authority": {"const": "none"},
    "production_authorized": {"const": false},
    "project_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "manifest": {"$ref": "benchmark-manifest-v1.schema.json"},
    "source_draft_sha256": {"$ref": "#/$defs/sha"},
    "revision": {"type": "integer", "minimum": 0, "maximum": 255},
    "previous_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha"}]},
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resolved_project_sha256", "input_identity_sha256"],
      "properties": {
        "resolved_project_sha256": {"$ref": "#/$defs/sha"},
        "input_identity_sha256": {"$ref": "#/$defs/sha"}
      }
    }
  },
  "$defs": {"sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
