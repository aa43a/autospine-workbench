{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object","additionalProperties":false,
  "required":["schema","source_curves_sha256","analysis","authority","production_authorized","status"],
  "properties":{
    "schema":{"const":"autospine.seam-arc-pairs/v1"},
    "source_curves_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "authority":{"const":"none"},"production_authorized":{"const":false},"status":{"const":"needs_review"},
    "analysis":{
      "type":"object","additionalProperties":false,
      "required":["profile","arcs","relations","authority","shape_solver","max_support_gap_edges"],
      "properties":{
        "profile":{"const":"alpha8-local-gap4-ordered-pairs-v1"},
        "authority":{"const":"none"},"shape_solver":{"const":"not_run"},"max_support_gap_edges":{"const":4},
        "arcs":{"type":"object","additionalProperties":{"type":"array","items":{"$ref":"#/$defs/arc"}}},
        "relations":{"type":"array","items":{"$ref":"#/$defs/relation"}}
      }
    }
  },
  "$defs":{
    "index":{"type":"integer","minimum":0},
    "indices":{"type":"array","items":{"$ref":"#/$defs/index"}},
    "point":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"number"}},
    "arc":{
      "type":"object","additionalProperties":false,"required":["curve","edges","status"],
      "properties":{
        "curve":{"$ref":"#/$defs/index"},"edges":{"$ref":"#/$defs/indices"},
        "supported_edges":{"$ref":"#/$defs/indices"},"inserted_edges":{"$ref":"#/$defs/index"},
        "status":{"enum":["whole_contour_unsupported","single_edge","local_arc_candidate"]}
      }
    },
    "path":{
      "type":"object","additionalProperties":false,
      "required":["pair","d","f","driver_option","follower_option","driver_point","follower_point","cost"],
      "properties":{
        "pair":{"$ref":"#/$defs/index"},"d":{"type":"number"},"f":{"type":"number"},
        "driver_option":{"$ref":"#/$defs/index"},"follower_option":{"$ref":"#/$defs/index"},
        "driver_point":{"$ref":"#/$defs/point"},"follower_point":{"$ref":"#/$defs/point"},
        "cost":{"type":"number","minimum":0}
      }
    },
    "group":{
      "type":"object","additionalProperties":false,
      "required":["driver_arc","follower_arc","pairs","status","reason_code"],
      "properties":{
        "driver_arc":{"$ref":"#/$defs/index"},"follower_arc":{"$ref":"#/$defs/index"},"pairs":{"$ref":"#/$defs/indices"},
        "status":{"enum":["blocked","candidate_requires_review"]},
        "reason_code":{"enum":["insufficient_arc_pairs","nonmonotone_correspondence","many_to_one_requires_review","ordered_arc_candidate"]},
        "direction":{"enum":[-1,1]},"cost":{"type":"number","minimum":0},
        "path":{"type":"array","items":{"$ref":"#/$defs/path"}},
        "alternative_margin":{"type":["number","null"],"minimum":0},"many_to_one_steps":{"$ref":"#/$defs/index"}
      },
      "if":{"properties":{"status":{"const":"candidate_requires_review"}}},
      "then":{"required":["direction","cost","path","alternative_margin","many_to_one_steps"]}
    },
    "relation":{
      "type":"object","additionalProperties":false,"required":["driver","follower","source_pair_count","groups","blocked_pairs"],
      "properties":{
        "driver":{"type":"string"},"follower":{"type":"string"},"source_pair_count":{"$ref":"#/$defs/index"},
        "groups":{"type":"array","items":{"$ref":"#/$defs/group"}},
        "blocked_pairs":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["pair","reason_code"],
          "properties":{"pair":{"$ref":"#/$defs/index"},"reason_code":{"const":"arc_missing_or_ambiguous"}}}}
      }
    }
  }
}
