{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autospine-workbench.local/schemas/animated-input-registration-v3.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "source_kind", "authority", "production_authorized", "project_id", "manifest", "source_draft_sha256", "checkpoint", "revision", "previous_sha256"],
  "properties": {
    "schema": {"const": "autospine.animated-input-registration/v3"},
    "source_kind": {"const": "project_audit"},
    "authority": {"const": "none"}, "production_authorized": {"const": false},
    "project_id": {"$ref": "animated-input-registration-v1.schema.json#/properties/project_id"},
    "manifest": {"$ref": "project-audit-source-v1.schema.json"},
    "source_draft_sha256": {"$ref": "animated-input-registration-v1.schema.json#/$defs/sha"},
    "checkpoint": {"$ref": "animated-input-registration-v1.schema.json#/properties/checkpoint"},
    "revision": {"type": "integer", "minimum": 0, "maximum": 255},
    "previous_sha256": {"anyOf": [{"type": "null"}, {"$ref": "animated-input-registration-v1.schema.json#/$defs/sha"}]},
    "authoring_rebase": {"$ref": "animated-authoring-rebase-v1.schema.json"}
  }
}
