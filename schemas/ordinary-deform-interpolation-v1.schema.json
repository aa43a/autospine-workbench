{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "type":"object","additionalProperties":false,
 "required":["schema","profile","project_id","deform_sha256","repair_sha256","source_sha256","draft_sha256","skeleton_sha256","records","continuous_time_proven","temporal_quality_status","target_interpolation_status","runtime_status","authority","production_authorized"],
 "properties":{
  "schema":{"const":"autospine.ordinary-deform-interpolation/v1"},"profile":{"const":"ordinary-deform-quarter-tick513-v1"},
  "project_id":{"type":"string","minLength":1},
  "deform_sha256":{"$ref":"#/$defs/sha"},"repair_sha256":{"$ref":"#/$defs/sha"},"source_sha256":{"$ref":"#/$defs/sha"},"draft_sha256":{"$ref":"#/$defs/sha"},"skeleton_sha256":{"$ref":"#/$defs/sha"},
  "continuous_time_proven":{"const":false},"temporal_quality_status":{"const":"needs_review"},"target_interpolation_status":{"const":"not_evaluated"},"runtime_status":{"const":"not_evaluated"},
  "authority":{"const":"none"},"production_authorized":{"const":false},
  "records":{"type":"array","items":{"$ref":"#/$defs/region"}}
 },
 "$defs":{
  "sha":{"type":"string","pattern":"^[a-f0-9]{64}$"},
  "number":{"type":"number","minimum":0},
  "indices":{"type":"array","uniqueItems":true,"items":{"type":"integer","minimum":0,"maximum":512}},
  "region":{"type":"object","additionalProperties":false,"required":["layer_id","component_id","status","reason_codes","tracks"],
   "properties":{"layer_id":{"type":"string"},"component_id":{"type":"string"},"status":{"enum":["blocked","sampled_interpolation_passed"]},
    "reason_codes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "tracks":{"type":"array","maxItems":4,"items":{"$ref":"#/$defs/track"}}},
   "allOf":[{"if":{"properties":{"status":{"const":"sampled_interpolation_passed"}}},"then":{"properties":{"tracks":{"minItems":4}}}}]},
  "track":{"type":"object","additionalProperties":false,
   "required":["bone_id","profile","substeps","sample_count","sample_interval_seconds","qa","failed_samples","failed_between_keys","new_failed_between_keys","max_offset_px","loop_error","setup_error","setup_exact","loop_exact","max_cyclic_delta_step_px","max_cyclic_delta_second_difference_px","max_cyclic_delta_second_difference_normalized","median_edge_px","continuous_time_proven","runtime_status"],
   "properties":{
    "bone_id":{"enum":["forearm","hand","combined_same","combined_opposed"]},"profile":{"const":"analytic-fk-linear-world-delta-substeps4-v1"},"substeps":{"const":4},"sample_count":{"const":513},"sample_interval_seconds":{"const":0.00390625},
    "qa":{"type":"array","minItems":513,"maxItems":513,"items":{"$ref":"ordinary-sleeve-motion-v1.schema.json#/$defs/qa"}},
    "failed_samples":{"$ref":"#/$defs/indices"},"failed_between_keys":{"$ref":"#/$defs/indices"},"new_failed_between_keys":{"$ref":"#/$defs/indices"},
    "max_offset_px":{"$ref":"#/$defs/number"},"loop_error":{"$ref":"#/$defs/number"},"setup_error":{"$ref":"#/$defs/number"},
    "setup_exact":{"type":"boolean"},"loop_exact":{"type":"boolean"},
    "max_cyclic_delta_step_px":{"$ref":"#/$defs/number"},"max_cyclic_delta_second_difference_px":{"$ref":"#/$defs/number"},"max_cyclic_delta_second_difference_normalized":{"$ref":"#/$defs/number"},
    "median_edge_px":{"type":"number","exclusiveMinimum":0},"continuous_time_proven":{"const":false},"runtime_status":{"const":"not_evaluated"}
   }}
 }
}
