{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "authority",
    "production_authorized",
    "target",
    "scope",
    "source_bake_sha256",
    "skeleton_json_sha256",
    "included_layers",
    "excluded_layers",
    "full_character_status",
    "seam_status",
    "reason_codes",
    "runtime_status",
    "source_bindings_sha256",
    "source_draft_sha256",
    "rigid_layers",
    "draw_order_status"
  ],
  "properties": {
    "schema": {
      "const": "autospine.character-target-preview/v1"
    },
    "authority": {
      "const": "none"
    },
    "production_authorized": {
      "const": false
    },
    "target": {
      "const": "4.3.26"
    },
    "scope": {
      "const": "confirmed_binding_subset"
    },
    "source_bake_sha256": {
      "$ref": "#/$defs/sha"
    },
    "skeleton_json_sha256": {
      "$ref": "#/$defs/sha"
    },
    "included_layers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "excluded_layers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "layer_id",
          "reason_code"
        ],
        "properties": {
          "layer_id": {
            "type": "string"
          },
          "reason_code": {
            "enum": [
              "binding_pending",
              "binding_requires_split",
              "binding_exclude",
              "binding_semantic_review",
              "selected_mesh_bake_required"
            ]
          }
        }
      }
    },
    "full_character_status": {
      "const": "blocked"
    },
    "seam_status": {
      "const": "not_evaluated"
    },
    "runtime_status": {
      "const": "not_evaluated"
    },
    "reason_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "cross_layer_seam_review_required",
          "remaining_layer_bindings_required"
        ]
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/sha"
      }
    },
    "zip_sha256": {
      "$ref": "#/$defs/sha"
    },
    "source_bindings_sha256": {
      "$ref": "#/$defs/sha"
    },
    "source_draft_sha256": {
      "$ref": "#/$defs/sha"
    },
    "rigid_layers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "draw_order_status": {
      "const": "source_order_unreviewed"
    },
    "contact_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "authority",
        "seam_certified",
        "sample_count_per_pair",
        "pairs"
      ],
      "properties": {
        "profile": {
          "const": "shoulder-alpha-overlap-16-v1"
        },
        "authority": {
          "const": "none"
        },
        "seam_certified": {
          "const": false
        },
        "sample_count_per_pair": {
          "const": 61
        },
        "pairs": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "arm_layer",
              "torso_layer",
              "overlap_pixel_count",
              "status",
              "reason_code",
              "max_anchor_gap_px",
              "anchors"
            ],
            "properties": {
              "arm_layer": {
                "type": "string"
              },
              "torso_layer": {
                "type": "string"
              },
              "overlap_pixel_count": {
                "type": "integer",
                "minimum": 0
              },
              "status": {
                "enum": [
                  "candidate_requires_review",
                  "unobservable"
                ]
              },
              "reason_code": {
                "enum": [
                  "sampled_alpha_overlap_only",
                  "shoulder_overlap_unobservable"
                ]
              },
              "max_anchor_gap_px": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "anchors": {
                "type": "array",
                "maxItems": 16,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "setup_xy",
                    "triangle_index",
                    "barycentric"
                  ],
                  "properties": {
                    "setup_xy": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 2,
                      "items": {
                        "type": "number"
                      }
                    },
                    "triangle_index": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "barycentric": {
                      "type": "array",
                      "minItems": 3,
                      "maxItems": 3,
                      "items": {
                        "type": "number"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
