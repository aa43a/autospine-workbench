{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "autospine.region-binding-draft/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "authority",
    "production_authorized",
    "source_bindings_sha256",
    "records"
  ],
  "properties": {
    "schema": {
      "const": "autospine.region-binding-draft/v1"
    },
    "authority": {
      "const": "none"
    },
    "production_authorized": {
      "const": false
    },
    "source_bindings_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "layer_id",
          "action",
          "bone_id",
          "notes"
        ],
        "properties": {
          "layer_id": {
            "type": "string"
          },
          "action": {
            "enum": [
              "pending",
              "bind",
              "requires_split",
              "exclude",
              "semantic_review"
            ]
          },
          "bone_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "notes": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "action": {
                  "const": "bind"
                }
              }
            },
            "then": {
              "properties": {
                "bone_id": {
                  "type": "string"
                }
              }
            },
            "else": {
              "properties": {
                "bone_id": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "action": {
                  "enum": [
                    "requires_split",
                    "exclude",
                    "semantic_review"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "notes": {
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            }
          }
        ]
      }
    }
  }
}
