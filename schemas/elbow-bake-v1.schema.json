{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object","additionalProperties":false,
  "required":["schema","profile","authority","production_authorized","source_mesh_sha256","source_skeleton_sha256","fps","duration","interpolation","qa_sample_fps","seam_status","runtime_status","layers"],
  "properties":{
    "schema":{"const":"autospine.elbow-bake/v1"},
    "profile":{"const":"bounded-elbow-loop-30fps-v1"},
    "authority":{"const":"none"},"production_authorized":{"const":false},
    "source_mesh_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "source_skeleton_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "fps":{"const":30},"duration":{"const":2},"qa_sample_fps":{"const":120},
    "interpolation":{"const":"linear_local_offsets_and_angle"},
    "seam_status":{"const":"not_evaluated"},"runtime_status":{"const":"not_evaluated"},
    "layers":{"type":"array","maxItems":4096,"items":{
      "type":"object","additionalProperties":false,"required":["layer_id","status","reason_codes","frames","qa"],
      "properties":{
        "layer_id":{"type":"string","minLength":1},"status":{"enum":["passed","blocked","not_evaluated"]},
        "reason_codes":{"type":"array","uniqueItems":true,"items":{"enum":["weighted_mesh_required","mesh_area_compression","mesh_area_expansion","mesh_edge_stretch","mesh_triangle_inversion","corrective_interpolation_error","loop_mismatch","mesh_setup_mismatch"]}},
        "frames":{"type":"array","maxItems":61,"items":{
          "type":"object","additionalProperties":false,"required":["angle","offsets"],
          "properties":{"angle":{"type":"number","minimum":-90,"maximum":90},
            "offsets":{"type":"array","minItems":3,"maxItems":4096,"items":{
              "type":"array","minItems":3,"maxItems":3,"items":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"number"}}
            }}
          }
        }},
        "qa":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/qa"}]}
      },
      "if":{"properties":{"status":{"const":"not_evaluated"}}},
      "then":{"properties":{"frames":{"maxItems":0},"qa":{"type":"null"},"reason_codes":{"const":["weighted_mesh_required"]}}},
      "else":{"properties":{"frames":{"minItems":61},"qa":{"$ref":"#/$defs/qa"}}}
    }}
  },
  "$defs":{"qa":{
    "type":"object","additionalProperties":false,
    "required":["min_area_ratio","max_area_ratio","max_edge_stretch","inverted_triangle_samples","max_interpolation_error_px","loop_max_error","setup_max_error"],
    "properties":{
      "min_area_ratio":{"type":"number"},"max_area_ratio":{"type":"number"},
      "max_edge_stretch":{"type":"number","minimum":0},"inverted_triangle_samples":{"type":"integer","minimum":0},
      "max_interpolation_error_px":{"type":"number","minimum":0},"loop_max_error":{"type":"number","minimum":0},"setup_max_error":{"type":"number","minimum":0}
    }
  }}
}
