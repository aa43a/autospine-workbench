{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autospine.local/schemas/spine42-v3-export-report-v2.schema.json",
  "title": "AutoSpine P10.6b v2 Spine 4.2 export report v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format", "format_version", "status", "project_id", "clip_id",
    "source", "outputs", "checks", "metrics", "authority", "release_gate"
  ],
  "properties": {
    "format": {"const": "autospine-spine42-v3-export-report"},
    "format_version": {"const": 2},
    "status": {"const": "passed"},
    "project_id": {"$ref": "spine42-v3-export-run-v2.schema.json#/$defs/token"},
    "clip_id": {"$ref": "spine42-v3-export-run-v2.schema.json#/$defs/token"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": [
        "p3", "motion_instance_v3_v2", "source_contract_sha256",
        "adapter_profile_sha256", "run_identity_sha256", "run_document_sha256"
      ],
      "properties": {
        "p3": {"$ref": "spine42-v3-export-run-v2.schema.json#/$defs/p3"},
        "motion_instance_v3_v2": {"$ref": "spine42-v3-export-run-v2.schema.json#/$defs/motionInstanceV3V2"},
        "source_contract_sha256": {"$ref": "spine42-v3-export-run-v2.schema.json#/$defs/sha256"},
        "adapter_profile_sha256": {"$ref": "spine42-v3-export-run-v2.schema.json#/$defs/sha256"},
        "run_identity_sha256": {"$ref": "spine42-v3-export-run-v2.schema.json#/$defs/sha256"},
        "run_document_sha256": {"$ref": "spine42-v3-export-run-v2.schema.json#/$defs/sha256"}
      }
    },
    "outputs": {"$ref": "spine42-v3-export-run-v2.schema.json#/$defs/outputs"},
    "checks": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "prefixItems": [
        {"$ref": "#/$defs/adapterCheck"},
        {"$ref": "#/$defs/sourceContractCheck"},
        {"$ref": "#/$defs/motionCheck"},
        {"$ref": "#/$defs/attachmentCheck"},
        {"$ref": "#/$defs/geometryCheck"},
        {"$ref": "#/$defs/sourceCheck"}
      ],
      "items": false
    },
    "metrics": {
      "type": "object", "additionalProperties": false,
      "required": [
        "bones", "slots", "attachments", "animations", "events",
        "atlas_regions", "atlas_width", "atlas_height", "source_images"
      ],
      "properties": {
        "bones": {"type": "integer", "minimum": 1, "maximum": 4096},
        "slots": {"type": "integer", "minimum": 1, "maximum": 4096},
        "attachments": {"type": "integer", "minimum": 1, "maximum": 16384},
        "animations": {"const": 1},
        "events": {"type": "integer", "minimum": 0, "maximum": 4096},
        "atlas_regions": {"type": "integer", "minimum": 1, "maximum": 4096},
        "atlas_width": {"type": "integer", "minimum": 1, "maximum": 4096},
        "atlas_height": {"type": "integer", "minimum": 1, "maximum": 4096},
        "source_images": {"type": "integer", "minimum": 1, "maximum": 4096}
      }
    },
    "authority": {"$ref": "spine42-v3-export-run-v2.schema.json#/$defs/authority"},
    "release_gate": {"$ref": "spine42-v3-export-run-v2.schema.json#/$defs/releaseGate"}
  },
  "$defs": {
    "passedCheck": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "status"],
      "properties": {"id": {"type": "string"}, "status": {"const": "passed"}}
    },
    "adapterCheck": {
      "$ref": "#/$defs/passedCheck", "properties": {"id": {"const": "adapter-profile"}}
    },
    "sourceContractCheck": {
      "$ref": "#/$defs/passedCheck", "properties": {"id": {"const": "source-contract-v2"}}
    },
    "motionCheck": {
      "$ref": "#/$defs/passedCheck", "properties": {"id": {"const": "motion-instance-v3-v2-binding"}}
    },
    "attachmentCheck": {
      "$ref": "#/$defs/passedCheck", "properties": {"id": {"const": "attachment-atlas-binding"}}
    },
    "geometryCheck": {
      "$ref": "#/$defs/passedCheck", "properties": {"id": {"const": "atlas-png-geometry"}}
    },
    "sourceCheck": {
      "$ref": "#/$defs/passedCheck", "properties": {"id": {"const": "source-image-binding"}}
    }
  }
}
