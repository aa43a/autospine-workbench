{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autospine-workbench.local/schemas/input-preparation-request-v1.schema.json",
  "title": "Project preparation HTTP request; project identity comes from the route",
  "type": "object", "additionalProperties": false,
  "required": ["expected_resolved_sha256"],
  "properties": {"expected_resolved_sha256": {"$ref": "#/$defs/sha"}},
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "project": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "durable": {
      "type": "object", "additionalProperties": false,
      "required": ["project_id", "expected_resolved_sha256"],
      "properties": {"project_id": {"$ref": "#/$defs/project"}, "expected_resolved_sha256": {"$ref": "#/$defs/sha"}}
    }
  }
}
