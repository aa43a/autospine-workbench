{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authority",
    "production_authorized",
    "target",
    "source_atlas_sha256",
    "source_skeleton_sha256",
    "regions",
    "residuals",
    "scope",
    "full_character_status",
    "runtime_status",
    "seam_status",
    "files",
    "zip_sha256",
    "schema",
    "profile",
    "animation",
    "source_original_atlas_sha256",
    "source_width_sha256",
    "width_factor",
    "continuous_motion_status",
    "results"
  ],
  "properties": {
    "authority": {
      "$ref": "ownership-target-preview-v1.schema.json#/properties/authority"
    },
    "production_authorized": {
      "$ref": "ownership-target-preview-v1.schema.json#/properties/production_authorized"
    },
    "target": {
      "$ref": "ownership-target-preview-v1.schema.json#/properties/target"
    },
    "source_atlas_sha256": {
      "$ref": "ownership-target-preview-v1.schema.json#/properties/source_atlas_sha256"
    },
    "source_skeleton_sha256": {
      "$ref": "ownership-target-preview-v1.schema.json#/properties/source_skeleton_sha256"
    },
    "regions": {
      "$ref": "ownership-target-preview-v1.schema.json#/properties/regions"
    },
    "residuals": {
      "$ref": "ownership-target-preview-v1.schema.json#/properties/residuals"
    },
    "scope": {
      "$ref": "ownership-target-preview-v1.schema.json#/properties/scope"
    },
    "full_character_status": {
      "$ref": "ownership-target-preview-v1.schema.json#/properties/full_character_status"
    },
    "runtime_status": {
      "$ref": "ownership-target-preview-v1.schema.json#/properties/runtime_status"
    },
    "seam_status": {
      "$ref": "ownership-target-preview-v1.schema.json#/properties/seam_status"
    },
    "files": {
      "$ref": "ownership-target-preview-v1.schema.json#/properties/files"
    },
    "zip_sha256": {
      "$ref": "ownership-target-preview-v1.schema.json#/properties/zip_sha256"
    },
    "schema": {
      "const": "autospine.combined-corrective-preview/v1"
    },
    "profile": {
      "const": "distal-then-main-stepped-v1"
    },
    "animation": {
      "const": "discrete_combined_corrective_inspection"
    },
    "source_original_atlas_sha256": {
      "$ref": "#/properties/source_atlas_sha256"
    },
    "source_width_sha256": {
      "$ref": "#/properties/source_atlas_sha256"
    },
    "width_factor": {
      "const": 4
    },
    "continuous_motion_status": {
      "const": "not_evaluated"
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "layer_id",
          "status",
          "poses"
        ],
        "properties": {
          "layer_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "blocked",
              "candidate_requires_review"
            ]
          },
          "poses": {
            "type": "array",
            "minItems": 46,
            "maxItems": 46,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "main_angle",
                "distal_angle",
                "qa"
              ],
              "properties": {
                "main_angle": {
                  "enum": [
                    -30,
                    0,
                    30,
                    60,
                    90
                  ]
                },
                "distal_angle": {
                  "enum": [
                    -90,
                    -60,
                    -30,
                    -15,
                    0,
                    15,
                    30,
                    60,
                    90
                  ]
                },
                "qa": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "max_edge_stretch",
                    "offset_reconstruction_error",
                    "main_projection_displacement_px",
                    "main_fixed_vertex_error",
                    "min_area_ratio",
                    "max_area_ratio",
                    "passed",
                    "distal_stage_passed",
                    "inversions"
                  ],
                  "properties": {
                    "max_edge_stretch": {
                      "type": "number",
                      "minimum": 0
                    },
                    "offset_reconstruction_error": {
                      "type": "number",
                      "minimum": 0
                    },
                    "main_projection_displacement_px": {
                      "type": "number",
                      "minimum": 0
                    },
                    "main_fixed_vertex_error": {
                      "type": "number",
                      "minimum": 0
                    },
                    "min_area_ratio": {
                      "type": "number"
                    },
                    "max_area_ratio": {
                      "type": "number"
                    },
                    "passed": {
                      "type": "boolean"
                    },
                    "distal_stage_passed": {
                      "type": "boolean"
                    },
                    "inversions": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
