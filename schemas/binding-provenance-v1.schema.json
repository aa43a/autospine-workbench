{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "autospine.binding-provenance/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "authority",
    "production_authorized",
    "source_addresses",
    "rows"
  ],
  "properties": {
    "schema": {
      "const": "autospine.binding-provenance/v1"
    },
    "authority": {
      "const": "none"
    },
    "production_authorized": {
      "const": false
    },
    "source_addresses": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "decision_source",
          "decision_sha256",
          "policy_id",
          "evidence_current",
          "layer_id",
          "action",
          "option_id"
        ],
        "properties": {
          "decision_source": {
            "enum": [
              "policy_auto",
              "explicit_selection",
              "legacy_selection",
              "pending"
            ]
          },
          "decision_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "policy_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_current": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "layer_id": {
            "type": "string"
          },
          "action": {
            "enum": [
              "pending",
              "bind",
              "requires_split",
              "exclude",
              "semantic_review"
            ]
          },
          "option_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
