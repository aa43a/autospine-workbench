{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "autospine.benchmark-source-verification/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "authority", "dataset_sha256", "status", "counts", "files", "rigging_evaluation"],
  "properties": {
    "schema": {"const": "autospine.benchmark-source-verification/v1"},
    "authority": {"const": "none"},
    "dataset_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"enum": ["verified", "blocked"]},
    "rigging_evaluation": {"const": "not_run"},
    "counts": {
      "type": "object", "additionalProperties": false, "required": ["total", "verified"],
      "properties": {"total": {"const": 32}, "verified": {"type": "integer", "minimum": 0, "maximum": 32}}
    },
    "files": {
      "type": "array", "minItems": 32, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "expected_sha256", "status", "reason_code"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "expected_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "status": {"enum": ["verified", "blocked"]},
          "reason_code": {"enum": [null, "source_path_invalid", "source_unavailable", "source_content_changed", "source_format_invalid", "source_canvas_changed"]}
        }
      }
    }
  }
}
