{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autospine.local/schemas/motion-instance-v3-bundle-run-v2.schema.json",
  "title": "AutoSpine immutable body-sway MotionInstance v3 bundle provenance v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format", "format_version", "project_id", "clip_id", "inputs",
    "outputs", "authority", "release_gate", "compiler"
  ],
  "properties": {
    "format": {"const": "autospine-body-sway-motion-instance-v3-bundle-run"},
    "format_version": {"type": "integer", "const": 2},
    "project_id": {"$ref": "#/$defs/token"},
    "clip_id": {"$ref": "#/$defs/token"},
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "body_sway_motion_consumer_admission_v2_sha256",
        "body_sway_dynamic_seam_v2", "p9", "motion_domain_sha256",
        "rotation_timeline_sha256", "base_channels_sha256",
        "rig_ir_sha256", "target_profile_sha256"
      ],
      "properties": {
        "body_sway_motion_consumer_admission_v2_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "body_sway_dynamic_seam_v2": {"$ref": "#/$defs/dynamic_seam"},
        "p9": {"$ref": "#/$defs/p9"},
        "motion_domain_sha256": {"$ref": "#/$defs/sha256"},
        "rotation_timeline_sha256": {"$ref": "#/$defs/sha256"},
        "base_channels_sha256": {"$ref": "#/$defs/sha256"},
        "rig_ir_sha256": {"$ref": "#/$defs/sha256"},
        "target_profile_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "motion_instance_v3_sha256", "motion_instance_v3_profile_sha256"
      ],
      "properties": {
        "motion_instance_v3_sha256": {"$ref": "#/$defs/sha256"},
        "motion_instance_v3_profile_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "motion_instance_v3_emitted", "attachment_area_overlap_assessed",
        "dynamic_seam_safety", "full_attachment_boundary_continuity",
        "publishable_timeline", "spine_adapter_emitted",
        "runtime_equivalence", "raster_visual_quality",
        "persistent_current_head_authority", "release_authority"
      ],
      "properties": {
        "motion_instance_v3_emitted": {"const": true},
        "attachment_area_overlap_assessed": {"const": false},
        "dynamic_seam_safety": {"const": false},
        "full_attachment_boundary_continuity": {"const": false},
        "publishable_timeline": {"const": false},
        "spine_adapter_emitted": {"const": false},
        "runtime_equivalence": {"const": false},
        "raster_visual_quality": {"const": false},
        "persistent_current_head_authority": {"const": false},
        "release_authority": {"const": false}
      }
    },
    "release_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason_codes"],
      "properties": {
        "status": {"const": "blocked"},
        "reason_codes": {
          "const": [
            "attachment_area_overlap_not_assessed",
            "dynamic_seam_safety_unproven",
            "full_attachment_boundary_raster_visual_regression_missing",
            "persistent_current_head_authority_not_granted",
            "publishable_timeline_not_emitted",
            "raster_visual_quality_unproven",
            "runtime_equivalence_unproven",
            "spine_adapter_not_emitted"
          ]
        }
      }
    },
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {
          "const": "autospine-body-sway-motion-instance-v3-bundle-compiler-v2"
        },
        "version": {"const": "2.0.0"}
      }
    }
  },
  "$defs": {
    "token": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dynamic_seam": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_set_sha256", "source_document_sha256", "probe_sha256",
        "bundle_sha256"
      ],
      "properties": {
        "source_set_sha256": {"$ref": "#/$defs/sha256"},
        "source_document_sha256": {"$ref": "#/$defs/sha256"},
        "probe_sha256": {"$ref": "#/$defs/sha256"},
        "bundle_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "p9": {
      "type": "object",
      "additionalProperties": false,
      "required": ["motion_instance_v2_sha256", "bundle_sha256"],
      "properties": {
        "motion_instance_v2_sha256": {"$ref": "#/$defs/sha256"},
        "bundle_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
