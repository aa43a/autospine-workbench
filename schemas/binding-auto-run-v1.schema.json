{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "authority",
    "production_authorized",
    "changed",
    "status",
    "reason_code",
    "rounds",
    "changed_layer_ids",
    "batches"
  ],
  "properties": {
    "schema": {
      "const": "autospine.binding-auto-run/v1"
    },
    "authority": {
      "const": "none"
    },
    "production_authorized": {
      "const": false
    },
    "changed": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "succeeded",
        "stopped"
      ]
    },
    "reason_code": {
      "type": "string",
      "minLength": 1
    },
    "rounds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 32
    },
    "changed_layer_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "batches": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "decision_sha256",
          "changed_layer_ids"
        ],
        "properties": {
          "decision_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "changed_layer_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}