{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profile",
    "authority",
    "production_authorized",
    "source_partitions_sha256",
    "source_mesh_sha256",
    "source_skeleton_sha256",
    "residual_policy",
    "texture_sampling",
    "layers",
    "files",
    "runtime_status",
    "seam_status",
    "zip_sha256"
  ],
  "properties": {
    "schema": {
      "const": "autospine.layer-partitions/v2"
    },
    "profile": {
      "const": "shared-source-regional-weights-v1"
    },
    "authority": {
      "const": "none"
    },
    "production_authorized": {
      "const": false
    },
    "source_partitions_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_mesh_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_skeleton_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "residual_policy": {
      "const": "retain_original"
    },
    "texture_sampling": {
      "const": "ownership_mask_required"
    },
    "layers": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "layer_id",
          "bbox",
          "texture_ref",
          "ownership_ref",
          "partitions",
          "residual",
          "qa",
          "target_gate"
        ],
        "properties": {
          "layer_id": {
            "type": "string"
          },
          "bbox": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "integer"
            }
          },
          "texture_ref": {
            "type": "string"
          },
          "ownership_ref": {
            "type": "string"
          },
          "partitions": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "owner_code",
                "texture_ref",
                "ownership_ref",
                "source_region_mesh_sha256",
                "bone_ids",
                "geometry",
                "weight_support",
                "qa",
                "status",
                "review_status"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "owner_code": {
                  "enum": [
                    1,
                    2
                  ]
                },
                "texture_ref": {
                  "type": "string"
                },
                "ownership_ref": {
                  "type": "string"
                },
                "source_region_mesh_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "bone_ids": {
                  "$ref": "partition-mesh-v1.schema.json#/properties/layers/items/properties/bone_ids"
                },
                "geometry": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "vertices_xy",
                    "uvs",
                    "triangles",
                    "weights"
                  ],
                  "properties": {
                    "vertices_xy": {
                      "$ref": "partition-mesh-v1.schema.json#/properties/layers/items/properties/vertices_xy"
                    },
                    "uvs": {
                      "$ref": "partition-mesh-v1.schema.json#/properties/layers/items/properties/uvs"
                    },
                    "triangles": {
                      "$ref": "partition-mesh-v1.schema.json#/properties/layers/items/properties/triangles"
                    },
                    "weights": {
                      "$ref": "partition-mesh-v1.schema.json#/properties/layers/items/properties/weights"
                    }
                  }
                },
                "weight_support": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "rigid_vertex_counts",
                    "transition_vertex_count",
                    "confidence"
                  ],
                  "properties": {
                    "rigid_vertex_counts": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "transition_vertex_count": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "confidence": {
                      "const": "uncalibrated"
                    }
                  }
                },
                "qa": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "source_uv_max_error_px",
                    "deformation",
                    "coverage"
                  ],
                  "properties": {
                    "source_uv_max_error_px": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1e-07
                    },
                    "deformation": {
                      "$ref": "partition-mesh-v1.schema.json#/properties/layers/items/properties/qa"
                    },
                    "coverage": {
                      "$ref": "partition-mesh-v1.schema.json#/properties/layers/items/properties/raster_qa"
                    }
                  }
                },
                "status": {
                  "enum": [
                    "blocked",
                    "candidate_requires_review"
                  ]
                },
                "review_status": {
                  "const": "pending"
                }
              }
            }
          },
          "residual": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "owner_code",
              "status",
              "visible_pixels",
              "bone_ids",
              "confidence"
            ],
            "properties": {
              "owner_code": {
                "const": 3
              },
              "status": {
                "const": "preserved_unbound"
              },
              "visible_pixels": {
                "type": "integer",
                "minimum": 0
              },
              "bone_ids": {
                "const": []
              },
              "confidence": {
                "const": "unresolved"
              }
            }
          },
          "qa": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rgba_reconstruction_exact",
              "source_rgba_sha256",
              "reconstructed_rgba_sha256"
            ],
            "properties": {
              "rgba_reconstruction_exact": {
                "const": true
              },
              "source_rgba_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "reconstructed_rgba_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "target_gate": {
            "const": {
              "status": "blocked",
              "reason_code": "shared_texture_ownership_not_compiled"
            }
          }
        }
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "runtime_status": {
      "const": "not_evaluated"
    },
    "seam_status": {
      "const": "not_evaluated"
    },
    "zip_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autospine.local/schemas/layer-partitions-v2.schema.json"
}
