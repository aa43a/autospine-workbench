{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema","project_id","job_id","source_bundle_sha256","source_region_id","plan_sha256","authority","allowed_parents","parts","residual_pixels","image","width","height","bones"],
  "properties": {
    "schema": {"const": "autospine.component-mount-canvas/v1"},
    "project_id": {"type":"string"}, "job_id": {"type":"string"},
    "source_bundle_sha256": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "source_region_id": {"type":"string"},
    "plan_sha256": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "authority": {"const":"none"},
    "allowed_parents": {"type":"array","minItems":1,"maxItems":64,"uniqueItems":true,"items":{"type":"string"}},
    "width": {"type":"integer","minimum":1}, "height": {"type":"integer","minimum":1},
    "image": {"$ref":"#/$defs/png"}, "residual_pixels": {"type":"integer","minimum":0},
    "parts": {"type":"array","maxItems":64,"items":{
      "type":"object","additionalProperties":false,
      "required":["component_id","bbox","proposed_parent","visible_pixels","mask"],
      "properties":{
        "component_id":{"type":"string"}, "proposed_parent":{"type":"string"},
        "bbox":{"type":"array","minItems":4,"maxItems":4,"items":{"type":"integer","minimum":0}},
        "visible_pixels":{"type":"integer","minimum":1}, "mask":{"$ref":"#/$defs/png"}
      }
    }},
    "bones":{"type":"array","maxItems":64,"items":{
      "type":"object","additionalProperties":false,"required":["name","point","parent"],
      "properties":{"name":{"type":"string"},"parent":{"type":["string","null"]},
        "point":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"number"}}}
    }}
  },
  "$defs":{"png":{"type":"string","pattern":"^data:image/png;base64,[A-Za-z0-9+/=]+$"}}
}
