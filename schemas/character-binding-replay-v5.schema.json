{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$defs": {"sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "id": {"type": "string", "minLength": 1}},
  "properties": {
    "schema": {"const": "autospine.character-binding-replay/v5"},
    "profile": {"const": "extended-post-exclusion-binding-v1"},
    "decision_source": {"const": "verified_scope_replay"},
    "new_human_confirmation": {"const": false},
    "whole_character_visual_replayed": {"const": false},
    "authority": {"const": "none"},
    "production_authorized": {"const": false},
    "project_id": {"$ref": "#/$defs/id"},
    "job_id": {"$ref": "#/$defs/id"},
    "source_job_id": {"$ref": "#/$defs/id"},
    "artifact_sha256": {"$ref": "#/$defs/sha"},
    "runtime_sha256": {"$ref": "#/$defs/sha"},
    "layers_sha256": {"$ref": "#/$defs/sha"},
    "source_bundle_sha256": {"$ref": "#/$defs/sha"},
    "source_review_sha256": {"$ref": "#/$defs/sha"},
    "accepted_layer_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
  },
  "required": ["schema", "profile", "decision_source", "new_human_confirmation", "whole_character_visual_replayed", "authority", "production_authorized", "project_id", "job_id", "source_job_id", "artifact_sha256", "runtime_sha256", "layers_sha256", "source_bundle_sha256", "source_review_sha256", "accepted_layer_ids"]
}
