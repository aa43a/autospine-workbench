{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "profile", "authority", "production_authorized", "motion_review_reused", "previous_revision", "previous_registration_sha256", "previous_candidate_sha256", "previous_draft_sha256", "candidate_sha256", "draft_sha256"],
  "properties": {
    "schema": {"const": "autospine.sleeve-saved-reuse/v1"},
    "profile": {"const": "identical-annotation-surface-v1"},
    "authority": {"const": "none"},
    "production_authorized": {"const": false},
    "motion_review_reused": {"const": false},
    "previous_revision": {"type": "integer", "minimum": 1},
    "previous_registration_sha256": {"$ref": "#/$defs/sha"},
    "previous_candidate_sha256": {"$ref": "#/$defs/sha"},
    "previous_draft_sha256": {"$ref": "#/$defs/sha"},
    "candidate_sha256": {"$ref": "#/$defs/sha"},
    "draft_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {"sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
