{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "profile", "project_id", "sources", "draft_sha256", "skeleton_sha256", "sample_limit", "project_sample_limit", "records", "authority", "production_authorized"],
  "properties": {
    "schema": {"const": "autospine.component-weight-samples/v1"},
    "profile": {"const": "component-chain-weight-samples-v1"},
    "project_id": {"type": "string"}, "sources": {"type": "object"},
    "draft_sha256": {"$ref": "#/$defs/sha"}, "skeleton_sha256": {"$ref": "#/$defs/sha"},
    "sample_limit": {"type": "integer", "minimum": 0, "maximum": 64},
    "project_sample_limit": {"const": 256},
    "authority": {"const": "none"}, "production_authorized": {"const": false},
    "records": {"type": "array", "items": {"$ref": "#/$defs/record"}}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "point": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
    "influence": {
      "type": "object", "additionalProperties": false, "required": ["bone_id", "weight", "local_xy"],
      "properties": {"bone_id": {"type": "string"}, "weight": {"type": "number", "minimum": 0, "maximum": 1}, "local_xy": {"$ref": "#/$defs/point"}}
    },
    "record": {
      "type": "object", "additionalProperties": false,
      "required": ["layer_id", "component_id", "status", "reason_code", "bone_ids", "samples", "qa"],
      "properties": {
        "layer_id": {"type": "string"}, "component_id": {"type": "string"},
        "status": {"enum": ["blocked", "sampled_candidate"]}, "reason_code": {"type": "string"},
        "bone_ids": {"type": "array", "uniqueItems": true, "maxItems": 3, "items": {"type": "string"}},
        "samples": {"type": "array", "maxItems": 64, "items": {
          "type": "object", "additionalProperties": false, "required": ["canvas_xy", "influences"],
          "properties": {"canvas_xy": {"$ref": "#/$defs/point"}, "influences": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"$ref": "#/$defs/influence"}}}
        }},
        "qa": {"oneOf": [{"type": "null"}, {
          "type": "object", "additionalProperties": false, "required": ["setup_max_error", "weight_sum_max_error"],
          "properties": {"setup_max_error": {"type": "number", "minimum": 0}, "weight_sum_max_error": {"type": "number", "minimum": 0}}
        }]}
      }
    }
  }
}
