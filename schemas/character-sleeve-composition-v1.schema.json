{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Unified character sleeve candidate",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "authority", "production_authorized", "full_character_animation", "target", "profile", "source_addresses", "records", "region_owners", "layers", "animations", "status", "qa", "files"],
  "properties": {
    "schema": {"const": "autospine.character-sleeve-composition/v1"},
    "authority": {"const": "none"}, "production_authorized": {"const": false},
    "full_character_animation": {"const": false}, "target": {"const": "4.3.26"},
    "profile": {"const": "exact-sleeve-tracks-rgba-subset-v1"},
    "status": {"const": "needs_review"},
    "source_addresses": {"type": "object", "additionalProperties": {"type": "string"}},
    "records": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "region_owners": {"type": "object", "additionalProperties": {"type": "string"}},
    "layers": {"type": "array", "items": {"type": "object"}},
    "animations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "qa": {"type": "object", "additionalProperties": false,
      "required": ["component_fidelity", "unchanged_context_setup_error_px", "runtime_status", "full_character_contact_status"],
      "properties": {
        "component_fidelity": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "unchanged_context_setup_error_px": {"type": "number", "minimum": 0, "maximum": 0.0000001},
        "runtime_status": {"const": "not_run"}, "full_character_contact_status": {"const": "not_evaluated"}
      }
    },
    "files": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
  }
}
