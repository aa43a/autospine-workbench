{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autospine.local/schemas/coco17-detections-v1.schema.json",
  "title": "AutoSpine pinned COCO17 detections v1",
  "description": "Detector-neutral COCO17 xy + native score observations in project-canvas pixel space.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "format_version",
    "project_id",
    "source",
    "detector",
    "coordinate_system",
    "detected_count",
    "detections"
  ],
  "properties": {
    "format": { "const": "autospine-coco17-detections" },
    "format_version": { "const": 1 },
    "project_id": { "$ref": "#/$defs/id" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image_kind", "image_sha256", "canvas_size"],
      "properties": {
        "image_kind": { "const": "composite" },
        "image_sha256": { "$ref": "#/$defs/sha256" },
        "canvas_size": {
          "type": "array",
          "prefixItems": [
            { "type": "integer", "minimum": 1 },
            { "type": "integer", "minimum": 1 }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "detector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "model_revision", "config_sha256", "runtime"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "model_revision": { "type": "string", "minLength": 1, "maxLength": 256 },
        "model_sha256": { "$ref": "#/$defs/sha256" },
        "config_sha256": { "$ref": "#/$defs/sha256" },
        "runtime": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "coordinate_system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "x_axis", "y_axis", "units", "side_naming", "image_space"],
      "properties": {
        "origin": { "const": "top_left" },
        "x_axis": { "const": "right" },
        "y_axis": { "const": "down" },
        "units": { "const": "pixel" },
        "side_naming": { "const": "coco_character_side" },
        "image_space": {
          "enum": ["project_canvas", "horizontally_mirrored_project_canvas"]
        }
      }
    },
    "detected_count": { "type": "integer", "minimum": 1, "maximum": 100 },
    "detections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/detection" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "xy": {
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keypoints", "keypoint_scores"],
      "properties": {
        "keypoints": {
          "type": "array",
          "minItems": 17,
          "maxItems": 17,
          "items": { "$ref": "#/$defs/xy" }
        },
        "keypoint_scores": {
          "type": "array",
          "minItems": 17,
          "maxItems": 17,
          "items": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "visibility": {
          "type": "array",
          "minItems": 17,
          "maxItems": 17,
          "items": {
            "enum": ["visible", "occluded", "out_of_frame", "unknown"]
          }
        },
        "bbox_xywh": {
          "type": "array",
          "prefixItems": [
            { "type": "number" },
            { "type": "number" },
            { "type": "number", "exclusiveMinimum": 0 },
            { "type": "number", "exclusiveMinimum": 0 }
          ],
          "items": false,
          "minItems": 4,
          "maxItems": 4
        },
        "instance_score": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
