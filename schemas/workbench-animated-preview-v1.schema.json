{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autospine-workbench.local/schemas/workbench-animated-preview-v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "authority", "production_authorized", "target", "status", "full_character_animation", "animation", "regions", "bake_qa", "source_addresses", "summary", "review_items", "files"],
  "properties": {
    "schema": {"const": "autospine.workbench-animated-preview/v1"}, "authority": {"const": "none"},
    "production_authorized": {"const": false}, "target": {"const": "4.3.26"}, "status": {"const": "needs_review"},
    "full_character_animation": {"const": false}, "animation": {"$ref": "workbench-animated-definitions-v1.schema.json#/$defs/clip"},
    "regions": {"type": "array", "minItems": 1, "maxItems": 1024, "items": {"$ref": "workbench-animated-definitions-v1.schema.json#/$defs/region"}},
    "bake_qa": {"$ref": "workbench-animated-definitions-v1.schema.json#/$defs/geometry"},
    "source_addresses": {"$ref": "workbench-animated-definitions-v1.schema.json#/$defs/addresses"},
    "summary": {"$ref": "workbench-animated-definitions-v1.schema.json#/$defs/summary"},
    "review_items": {"type": "array", "items": {"$ref": "workbench-animated-definitions-v1.schema.json#/$defs/review"}},
    "files": {"type": "object", "minProperties": 5, "maxProperties": 1024,
      "propertyNames": {"pattern": "^(?!.*(?:^|/)\\.\\.?/)[A-Za-z0-9_./-]+$"},
      "additionalProperties": {"$ref": "workbench-animated-definitions-v1.schema.json#/$defs/sha"}},
    "stage_identity": {"$ref": "workbench-animated-definitions-v1.schema.json#/$defs/stage"}
  }
}
