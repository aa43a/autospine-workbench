{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "project_id", "input_identity_sha256", "status", "authority"],
  "properties": {
    "schema": {"const": "autospine.project-rig-plan-status/v1"},
    "project_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "input_identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"enum": ["missing", "ready"]},
    "authority": {"const": "none"},
    "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "plan": {"$ref": "rig-plan-v1.schema.json"},
    "readiness": {"oneOf": [{"$ref": "rig-plan-readiness-v1.schema.json"}, {"$ref": "rig-plan-readiness-v2.schema.json"}]},
    "visual": {
      "type": "object", "additionalProperties": false,
      "required": ["canvas", "composite_url", "layers"],
      "properties": {
        "canvas": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 1}},
        "composite_url": {"type": "string", "pattern": "^/api/projects/[^/]+/composite\\?source=[0-9a-f]{64}$"},
        "layers": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["layer_id", "bbox"],
          "properties": {
            "layer_id": {"type": "string"},
            "bbox": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "integer"}}
          }
        }}
      }
    }
  },
  "if": {"properties": {"status": {"const": "ready"}}},
  "then": {"required": ["plan_sha256", "plan"]},
  "else": {"not": {"anyOf": [{"required": ["plan_sha256"]}, {"required": ["plan"]}, {"required": ["visual"]}, {"required": ["readiness"]}]}}
}
