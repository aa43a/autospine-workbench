{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "project_id", "input_identity_sha256", "status", "authority"],
  "properties": {
    "schema": {"const": "autospine.project-rig-plan-status/v1"},
    "project_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "input_identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"enum": ["missing", "ready"]},
    "authority": {"const": "none"},
    "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "plan": {"$ref": "rig-plan-v1.schema.json"}
  },
  "if": {"properties": {"status": {"const": "ready"}}},
  "then": {"required": ["plan_sha256", "plan"]},
  "else": {"not": {"anyOf": [{"required": ["plan_sha256"]}, {"required": ["plan"]}]}}
}
