{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autospine.local/schemas/override-patch-v2.schema.json",
  "title": "AutoSpine override patch v2",
  "description": "Reviewer overrides with candidate-bound joint decisions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "base_revision",
    "joint_overrides",
    "joint_decisions",
    "layer_overrides",
    "notes"
  ],
  "properties": {
    "schema_version": { "const": "autospine-workbench.override/v2" },
    "base_revision": { "type": "integer", "minimum": 0 },
    "joint_overrides": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/jointOverride" }
    },
    "joint_decisions": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/jointDecision" }
    },
    "layer_overrides": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/layerOverride" }
    },
    "notes": { "type": "string", "maxLength": 10000 }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": ".*\\S.*"
    },
    "point": {
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "jointOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "reason": { "type": "string", "maxLength": 1000 }
      }
    },
    "jointDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "candidate_artifact_sha256"],
      "properties": {
        "action": { "enum": ["accept", "adjust", "reject", "unobservable"] },
        "candidate_artifact_sha256": { "$ref": "#/$defs/sha256" },
        "candidate_id": { "$ref": "#/$defs/id" },
        "final_xy": { "$ref": "#/$defs/point" },
        "reason": { "$ref": "#/$defs/reason" }
      },
      "allOf": [
        {
          "if": { "properties": { "action": { "const": "accept" } }, "required": ["action"] },
          "then": {
            "required": ["candidate_id"],
            "not": { "required": ["final_xy"] }
          }
        },
        {
          "if": { "properties": { "action": { "const": "adjust" } }, "required": ["action"] },
          "then": { "required": ["candidate_id", "final_xy", "reason"] }
        },
        {
          "if": { "properties": { "action": { "const": "reject" } }, "required": ["action"] },
          "then": {
            "required": ["candidate_id", "reason"],
            "not": { "required": ["final_xy"] }
          }
        },
        {
          "if": { "properties": { "action": { "const": "unobservable" } }, "required": ["action"] },
          "then": {
            "required": ["reason"],
            "not": {
              "anyOf": [
                { "required": ["candidate_id"] },
                { "required": ["final_xy"] }
              ]
            }
          }
        }
      ]
    },
    "layerOverride": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "canonical_role": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 96,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            { "type": "null" }
          ]
        },
        "side": { "enum": ["left", "right", "center", "bilateral", "unknown"] },
        "disposition": {
          "enum": [
            "auto",
            "keep",
            "exclude",
            "ignore",
            "split",
            "split_left_right",
            "merge",
            "review"
          ]
        },
        "pivot_xy": { "$ref": "#/$defs/point" },
        "visible": { "type": "boolean" },
        "notes": { "type": "string", "maxLength": 1000 }
      }
    }
  }
}
