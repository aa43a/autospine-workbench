{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "autospine.chain-coverage/v1",
  "$comment": "Semantic replay additionally verifies source identity, PSD coordinates, component totals and sample coverage ratios. Alpha coverage is diagnostic only; it grants no binding, weight or production authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "profile", "authority", "production_authorized", "source_bindings_sha256", "parameters", "layers"],
  "properties": {
    "schema": {"const": "autospine.chain-coverage/v1"},
    "profile": {"const": "alpha-chain-coverage-v1"},
    "authority": {"const": "none"},
    "production_authorized": {"const": false},
    "source_bindings_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}(?![\\s\\S])"},
    "parameters": {
      "type": "object", "additionalProperties": false,
      "required": ["alpha_threshold", "connectivity", "samples_per_bone", "radius_px", "low_coverage_ratio", "max_reported_components"],
      "properties": {
        "alpha_threshold": {"const": 8},
        "connectivity": {"const": 4},
        "samples_per_bone": {"const": 21},
        "radius_px": {"const": 3},
        "low_coverage_ratio": {"const": 0.5},
        "max_reported_components": {"const": 32}
      }
    },
    "layers": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/layer"}}
  },
  "$defs": {
    "identifier": {"type": "string", "minLength": 1},
    "count": {"type": "integer", "minimum": 0},
    "reasons": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "component": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "area", "bbox", "centroid"],
      "properties": {
        "id": {"type": "integer", "minimum": 0},
        "area": {"type": "integer", "minimum": 1},
        "bbox": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "integer"}},
        "centroid": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}}
      }
    },
    "bone": {
      "type": "object", "additionalProperties": false,
      "required": ["bone_id", "sample_count", "covered_samples", "coverage_ratio"],
      "properties": {
        "bone_id": {"$ref": "#/$defs/identifier"},
        "sample_count": {"const": 21},
        "covered_samples": {"type": "integer", "minimum": 0, "maximum": 21},
        "coverage_ratio": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "option": {
      "type": "object", "additionalProperties": false,
      "required": ["option_id", "bones", "reason_codes"],
      "properties": {
        "option_id": {"$ref": "#/$defs/identifier"},
        "bones": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/bone"}},
        "reason_codes": {"$ref": "#/$defs/reasons"}
      }
    },
    "layer": {
      "type": "object", "additionalProperties": false,
      "required": ["layer_id", "alpha_pixel_count", "component_count", "omitted_component_count", "omitted_alpha_pixel_count", "components", "options", "reason_codes"],
      "properties": {
        "layer_id": {"$ref": "#/$defs/identifier"},
        "alpha_pixel_count": {"$ref": "#/$defs/count"},
        "component_count": {"$ref": "#/$defs/count"},
        "omitted_component_count": {"$ref": "#/$defs/count"},
        "omitted_alpha_pixel_count": {"$ref": "#/$defs/count"},
        "components": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/component"}},
        "options": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/option"}},
        "reason_codes": {"$ref": "#/$defs/reasons"}
      }
    }
  }
}
