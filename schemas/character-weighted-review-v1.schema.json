{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "autospine.character-weighted-review/v1"
    },
    "project_id": {
      "type": "string"
    },
    "job_id": {
      "type": "string"
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "runtime_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "layers_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "previous_sha256": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "decision_source": {
      "const": "human_review"
    },
    "authority": {
      "const": "none"
    },
    "production_authorized": {
      "const": false
    },
    "accepted_layer_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema",
    "project_id",
    "job_id",
    "artifact_sha256",
    "runtime_sha256",
    "layers_sha256",
    "previous_sha256",
    "revision",
    "decision_source",
    "authority",
    "production_authorized",
    "accepted_layer_ids"
  ]
}
